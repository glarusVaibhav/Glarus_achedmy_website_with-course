          }
        },
        {
          "type": "scenario",
          "title": "The Agentic Resume ATS Problem",
          "description": "You are developing an automated Agentic Resume Editor to help candidates bypass Applicant Tracking Systems (ATS). \n\nThe candidate's resume explicitly lists the skill: 'React Developer'. \nThe job description asks for a: 'Frontend Engineer'. \n\nIf your pipeline uses Count Vectorizer (Bag of Words) instead of Word Embeddings, what will the similarity score be between these two phrases?",
          "choices": [
            {
              "text": "100% Match, because the algorithm has external knowledge that React is a frontend framework.",
              "outcome": "Incorrect. Bag of Words does not possess external knowledge or semantics. It only counts exact string matches.",
              "score": 0
            },
            {
              "text": "0% Match.",
              "outcome": "Correct! Because 'React' != 'Frontend' and 'Developer' != 'Engineer', Bag of Words sees 0 overlapping tokens. This is exactly why keyword-matching ATS systems reject good candidates, and why modern systems MUST use Word Embeddings for semantic matching!",
              "score": 100
