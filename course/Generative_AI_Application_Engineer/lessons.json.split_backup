        },
        {
          "type": "code",
          "challenge": {
            "question": "Train an LDA Topic Modeling model and display the discovered topics.",
            "starterCode": "from sklearn.feature_extraction.text import CountVectorizer\nfrom sklearn.decomposition import LatentDirichletAllocation\n\n# Sample Documents\ndocuments = [\n    'Football players scored many goals in the match',\n    'The team won the football tournament',\n    'Doctors treated patients in the hospital',\n    'Medicine helps patients recover quickly'\n]\n\n# Convert documents into a Document-Term Matrix\nvectorizer = CountVectorizer(stop_words='english')\nX = vectorizer.fit_transform(documents)\n\n# TODO: Create an LDA model with 2 topics\nlda = ____(n_components=2, random_state=42)\n\n# TODO: Train the model\n____.fit(X)\n\n# Display discovered topics\nterms = vectorizer.get_feature_names_out()\n\nfor i, topic in enumerate(lda.components_):\n    print(f'Topic {i+1}:')\n    top_words = [terms[index] for index in topic.argsort()[-5:][::-1]]\n    print(top_words)",
            "solution": "from sklearn.feature_extraction.text import CountVectorizer\nfrom sklearn.decomposition import LatentDirichletAllocation\n\n# Sample Documents\ndocuments = [\n    'Football players scored many goals in the match',\n    'The team won the football tournament',\n    'Doctors treated patients in the hospital',\n    'Medicine helps patients recover quickly'\n]\n\n# Convert documents into a Document-Term Matrix\nvectorizer = CountVectorizer(stop_words='english')\nX = vectorizer.fit_transform(documents)\n\n# Create an LDA model with 2 topics\nlda = LatentDirichletAllocation(n_components=2, random_state=42)\n\n# Train the model\nlda.fit(X)\n\n# Display discovered topics\nterms = vectorizer.get_feature_names_out()\n\nfor i, topic in enumerate(lda.components_):\n    print(f'Topic {i+1}:')\n    top_words = [terms[index] for index in topic.argsort()[-5:][::-1]]\n    print(top_words)\n\n# Expected Output:\n# Topic 1:\n# ['football', 'team', 'goals', 'match', 'tournament']\n#\n# Topic 2:\n# ['doctors', 'hospital', 'patients', 'medicine', 'treated']",
            "language": "python",
            "hint": "Use the `LatentDirichletAllocation` class from `sklearn.decomposition` and call the `.fit()` method to train the model."
          }
        },
