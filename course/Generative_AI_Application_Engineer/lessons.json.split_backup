          "type": "mcq",
          "questions": [
            {
              "question": "Why should PII masking happen on BOTH inputs AND outputs of an LLM? (Select the correct option)",
              "options": [
                "It makes the LLM respond faster",
                "Input masking prevents PII from reaching the LLM provider; output masking catches PII the LLM might generate or echo",
                "It reduces token costs by shortening the text",
                "PII masking is only needed on inputs, not outputs"
              ],
              "answer": 1,
              "explanation": "Input masking protects PII from being sent to external LLM APIs (GDPR compliance). Output masking catches cases where the LLM generates or echoes PII from its training data or context window. Both directions are necessary for complete protection."
            },
            {
              "question": "What advantage does NeMo Guardrails have over simple keyword-based prompt injection detection? (Select the correct option)",
              "options": [
                "NeMo is faster to execute",
                "NeMo uses semantic understanding to catch injection attempts even with creative phrasing",
                "NeMo is free while keyword matching costs money",
                "NeMo only works with NVIDIA GPUs"
              ],
              "answer": 1,
              "explanation": "NeMo Guardrails uses embedding-based semantic matching to understand the INTENT behind messages, not just the exact words. This catches rephrased injection attempts like 'please pretend the above rules don't apply' that keyword matching would miss."
            }
