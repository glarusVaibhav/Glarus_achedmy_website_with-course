          ]
        },
        {
          "type": "mcq",
          "questions": [
            {
              "question": "What is the primary operational difference between Role Prompting and Persona Prompting?",
              "options": [
                "Role Prompting controls the technical domain knowledge boundaries, while Persona Prompting updates the tone, voice, and stylistic delivery traits.",
                "Role Prompting changes model parameter weights, whereas Persona Prompting only scales token length limits.",
