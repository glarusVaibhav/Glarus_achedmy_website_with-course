            "starterCode": "from openai import OpenAI\nclient = OpenAI()\n\ndef llm_judge(question: str, response: str) -> dict:\n    judge_prompt = f'''Rate this AI response on two criteria:\n1. Accuracy (1-5): Are the facts correct?\n2. Helpfulness (1-5): Does it answer the question?\n\nQuestion: {question}\nResponse: {response}\n\nReturn ONLY a JSON object: {{\"accuracy\": X, \"helpfulness\": Y}}'''\n    \n    result = client.chat.completions.create(\n        model=___,\n        messages=[{'role': 'user', 'content': ___}],\n        response_format={'type': '___'}\n    )\n    \n    import json\n    return json.loads(result.choices[0].message.content)",
            "solution": "from openai import OpenAI\nclient = OpenAI()\n\ndef llm_judge(question: str, response: str) -> dict:\n    judge_prompt = f'''Rate this AI response on two criteria:\n1. Accuracy (1-5): Are the facts correct?\n2. Helpfulness (1-5): Does it answer the question?\n\nQuestion: {question}\nResponse: {response}\n\nReturn ONLY a JSON object: {{\"accuracy\": X, \"helpfulness\": Y}}'''\n    \n    result = client.chat.completions.create(\n        model='gpt-4o-mini',\n        messages=[{'role': 'user', 'content': judge_prompt}],\n        response_format={'type': 'json_object'}\n    )\n    \n    import json\n    return json.loads(result.choices[0].message.content)",
