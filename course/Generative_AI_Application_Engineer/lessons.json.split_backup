        {
          "type": "scenario",
          "title": "The Broken Colleague",
          "description": "Your coworker clones your NLP project from GitHub. They run `python main.py` on their machine, but it instantly crashes with the error: `ModuleNotFoundError: No module named 'transformers'`. What did they forget to do?",
          "choices": [
            {
