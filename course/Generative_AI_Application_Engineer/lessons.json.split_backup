            },
            {
              "beforeBlank": "ChromaDB uses the",
              "afterBlank": "distance metric by default to measure similarity between vectors",
              "answer": 0,
              "hint": "This metric measures the angle between two vectors, ranging from 0 (identical) to 2 (opposite)",
              "options": [
