            "solution": "colors = ['Red', 'Green', 'Blue']\nprint(colors[1])",
            "language": "python",
            "hint": "List indexing starts from 0."
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Create a set called `numbers` containing 1, 2, 2, 3, and 4. Print the set and observe what happens to the duplicate value.",
