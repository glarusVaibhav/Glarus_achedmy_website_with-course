            {
              "text": "The vector database will prioritize semantic closeness. It might return a perfect AI engineer who lives in New York, because 'New York' and 'New Delhi' are semantically similar (both are major cities).",
              "outcome": "Correct! Vector search understands concepts, not strict geographical rules. You MUST extract 'New Delhi' and pass it as a strict Metadata Filter (`where location == 'New Delhi'`) before running the vector search.",
              "score": 100
            },
            {
              "text": "The HNSW graph will crash due to polysemy.",
              "outcome": "Incorrect. HNSW handles complex concepts natively.",
              "score": 0
            }
          ]
        },
        {
          "type": "mcq",
          "questions": [
            {
              "question": "Why might a company choose Pinecone over ChromaDB?",
              "options": [
                "Pinecone is fully managed and cloud-native",
                "Pinecone only works offline",
                "Pinecone does not use embeddings",
                "Pinecone replaces LLMs"
              ],
              "answer": 0,
              "explanation": "Pinecone is a managed vector database service designed for production-scale deployments."
            },
            {
              "question": "What does 'Top-K Similar Vectors' mean?",
              "options": [
                "The K smallest vectors",
                "The K newest vectors",
                "The K most semantically similar vectors",
                "The K vectors with the most metadata"
              ],
              "answer": 2,
              "explanation": "Top-K returns the most relevant vectors according to the similarity metric."
            },
            {
              "question": "What is the main advantage of Approximate Nearest Neighbor (ANN) search?",
              "options": [
                "Perfect accuracy",
                "Reduced storage usage",
                "Much faster search speed",
                "No embeddings required"
              ],
              "answer": 2,
              "explanation": "ANN sacrifices a tiny amount of accuracy to achieve dramatically faster searches."
            },
            {
              "question": "In the library analogy for HNSW, what does the top layer represent?",
              "options": [
                "The exact book",
                "The correct page",
