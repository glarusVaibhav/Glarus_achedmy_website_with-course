          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Create a Word2Vec CBOW model using Gensim for the following sentences and print the vector for the word 'python': [['i', 'love', 'python'], ['python', 'is', 'powerful'], ['i', 'code', 'in', 'python']]",
            "starterCode": "from gensim.models import Word2Vec\n\nsentences = [\n    ['i', 'love', 'python'],\n    ['python', 'is', 'powerful'],\n    ['i', 'code', 'in', 'python']\n]\n\n# Write your code here\n",
            "solution": "from gensim.models import Word2Vec\n\nsentences = [\n    ['i', 'love', 'python'],\n    ['python', 'is', 'powerful'],\n    ['i', 'code', 'in', 'python']\n]\n\n# Write your code here\nmodel = Word2Vec(sentences, vector_size=50, window=2, min_count=1, sg=0)\nprint(model.wv['python'])",
            "language": "python",
