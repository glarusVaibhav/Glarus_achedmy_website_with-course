            "language": "cypher",
            "difficulty": "Medium",
            "startingCode": "// Find products purchased by New York customers\nMATCH \nRETURN ",
            "solution": "MATCH (p:Person {city: 'New York'})-[:PURCHASED]->(product:Product)\nRETURN p.name, product.name",
            "validation": true,
            "question": "Write the code here:",
            "starterCode": "// Write your Cypher query here"
