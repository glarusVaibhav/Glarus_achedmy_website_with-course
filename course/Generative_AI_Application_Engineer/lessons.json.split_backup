    },
    {
      "id": "M020-phase-5",
      "title": "Module 20: Phase 5 — RAG Engine & Retrieval Pipeline",
      "stages": [
        {
          "type": "concept",
          "title": "Step 6: Building the RAG Engine",
          "content": {
            "title": "Step 6: Building the RAG Engine",
            "explanation": "Now for the heart of the application — the RAG (Retrieval-Augmented Generation) engine. When a customer asks a question, this engine:\n\n1. **Embeds** the customer's question into a vector\n2. **Searches** ChromaDB for the most relevant knowledge base chunks\n3. **Constructs** a prompt with the retrieved context\n4. **Generates** a professional, accurate response using the LLM\n5. **Returns** the response with source citations\n\nIn Module 8, you learned the theory. Here, we build it for production.\n\n**Production RAG vs. Tutorial RAG:**\n| Feature | Tutorial | Production |\n|---------|----------|------------|\n| Error handling | None | Retry logic, fallbacks |\n| Prompt | Hardcoded | Templated, versioned |\n| Sources | Ignored | Cited in response |\n| Confidence | Not tracked | Scored 0-1 |\n| Caching | None | Redis-cached embeddings |\n| Logging | print() | Structured JSON logs |",
            "sections": [
              {
                "title": "The RAG Prompt Template",
                "body": "The prompt is the most critical piece. It must:\n- Give the AI a clear role and persona\n- Provide the retrieved context\n- Include strict instructions about hallucination\n- Request source citations\n- Handle the 'I don't know' case gracefully\n\nHere's our production prompt:\n```\nYou are a professional customer support assistant for {company_name}.\nYou help customers with their questions using ONLY the knowledge base provided below.\n\n=== KNOWLEDGE BASE CONTEXT ===\n{context}\n=== END CONTEXT ===\n\nCustomer Question: {question}\n\nINSTRUCTIONS:\n1. Answer ONLY based on the provided context\n2. If the context doesn't contain the answer, say: \"I don't have specific information about that. Let me connect you with a human agent.\"\n3. Cite your sources using [Source: filename] format\n4. Keep responses concise but complete\n5. Use a friendly, professional tone\n6. If the question involves account-specific data, suggest the customer check their account or contact support\n```"
              }
            ],
            "example": "# app/services/rag_engine.py\nfrom langchain_openai import ChatOpenAI, OpenAIEmbeddings\nimport chromadb\nimport redis.asyncio as aioredis\nimport json\nimport hashlib\nimport structlog\nfrom app.config import get_settings\n\nlogger = structlog.get_logger()\nsettings = get_settings()\n\nRAG_PROMPT = \"\"\"You are a professional customer support assistant.\nYou help customers using ONLY the knowledge base context below.\n\n=== KNOWLEDGE BASE CONTEXT ===\n{context}\n=== END CONTEXT ===\n\nCustomer Question: {question}\n\nINSTRUCTIONS:\n1. Answer ONLY based on the provided context.\n2. If the context doesn't contain the answer, say: \"I don't have specific information about that in our knowledge base. Let me connect you with a human agent who can help.\"\n3. Cite sources using [Source: filename] format.\n4. Be concise, professional, and friendly.\n5. Never make up information not in the context.\n\"\"\"\n\nclass RAGEngine:\n    def __init__(self):\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_MODEL,\n            api_key=settings.OPENAI_API_KEY,\n            temperature=0.1,  # Low temperature for factual responses\n        )\n        self.embeddings = OpenAIEmbeddings(\n            model=settings.EMBEDDING_MODEL,\n            api_key=settings.OPENAI_API_KEY\n        )\n        self.chroma = chromadb.HttpClient(\n            host=settings.CHROMA_HOST,\n            port=settings.CHROMA_PORT\n        )\n        self.collection = self.chroma.get_or_create_collection(\n            name=settings.CHROMA_COLLECTION\n        )\n\n    async def query(self, question: str, top_k: int = 5) -> dict:\n        \"\"\"Full RAG pipeline: embed → retrieve → generate.\"\"\"\n        # 1. Embed the question\n        query_vector = self.embeddings.embed_query(question)\n\n        # 2. Retrieve relevant chunks\n        results = self.collection.query(\n            query_embeddings=[query_vector],\n            n_results=top_k,\n            include=[\"documents\", \"metadatas\", \"distances\"]\n        )\n\n        # 3. Build context from retrieved chunks\n        context_parts = []\n        sources = []\n        for doc, meta, dist in zip(\n            results['documents'][0],\n            results['metadatas'][0],\n            results['distances'][0]\n        ):\n            context_parts.append(doc)\n            sources.append({\n                \"source\": meta.get(\"source\", \"unknown\"),\n                \"relevance\": round(1 - dist, 3)  # Convert distance to similarity\n            })\n\n        context = \"\\n\\n---\\n\\n\".join(context_parts)\n\n        # 4. Generate response\n        prompt = RAG_PROMPT.format(context=context, question=question)\n        response = await self.llm.ainvoke(prompt)\n\n        # 5. Calculate confidence (average relevance of top sources)\n        avg_relevance = sum(s[\"relevance\"] for s in sources) / len(sources) if sources else 0\n\n        return {\n            \"answer\": response.content,\n            \"sources\": sources[:3],  # Top 3 sources\n            \"confidence\": round(avg_relevance, 3),\n            \"chunks_retrieved\": len(context_parts)\n        }"
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Add Redis caching to the RAG engine. Create a method cached_query() that: hashes the question to create a cache key, checks Redis first (TTL: 1 hour), returns cached result if found, otherwise runs the full RAG pipeline and caches the result. This prevents repeated expensive LLM calls for the same question.",
            "starterCode": "import hashlib\nimport json\nimport redis.asyncio as aioredis\nfrom app.config import get_settings\n\nsettings = get_settings()\n\nclass RAGEngine:\n    # ... existing code from above ...\n\n    def _cache_key(self, question: str) -> str:\n        # TODO: Create a deterministic cache key from the question\n        pass\n\n    async def cached_query(self, question: str, redis_client, top_k: int = 5) -> dict:\n        # TODO: Check Redis cache first\n        # TODO: If miss, run full pipeline and cache result\n        pass",
            "solution": "import hashlib\nimport json\nimport redis.asyncio as aioredis\nfrom app.config import get_settings\n\nsettings = get_settings()\nCACHE_TTL = 3600  # 1 hour in seconds\n\nclass RAGEngine:\n    # ... existing code from above ...\n\n    def _cache_key(self, question: str) -> str:\n        \"\"\"Create a deterministic cache key from the question.\"\"\"\n        normalized = question.lower().strip()\n        hash_val = hashlib.sha256(normalized.encode()).hexdigest()[:16]\n        return f\"rag:cache:{hash_val}\"\n\n    async def cached_query(self, question: str, redis_client: aioredis.Redis, top_k: int = 5) -> dict:\n        \"\"\"Query with Redis caching to avoid repeated LLM calls.\"\"\"\n        cache_key = self._cache_key(question)\n\n        # 1. Check Redis cache\n        cached = await redis_client.get(cache_key)\n        if cached:\n            logger.info(\"Cache hit\", question=question[:50])\n            result = json.loads(cached)\n            result[\"cached\"] = True\n            return result\n\n        # 2. Cache miss — run full RAG pipeline\n        logger.info(\"Cache miss\", question=question[:50])\n        result = await self.query(question, top_k=top_k)\n        result[\"cached\"] = False\n\n        # 3. Cache the result (non-blocking)\n        await redis_client.setex(\n            cache_key,\n            CACHE_TTL,\n            json.dumps(result)\n        )\n\n        return result",
            "language": "python"
          }
        },
        {
          "type": "scenario",
          "scenario": "A customer submits the question: 'How do I cancel my subscription?' The RAG engine retrieves 5 chunks from the knowledge base, but the top result has a relevance score of only 0.42 (out of 1.0). The AI generates a response anyway.",
          "question": "What should the system do in this situation?",
          "options": [
            "Return the AI response anyway — 0.42 is close enough",
            "Set a confidence threshold (e.g., 0.6) and escalate to a human agent if the best retrieval score is below it",
            "Delete the low-quality knowledge base chunks",
            "Regenerate the response with a higher temperature"
          ],
          "answer": 1,
          "explanation": "A confidence threshold prevents the AI from generating low-quality or hallucinated responses. If the best retrieved chunk scored only 0.42, the knowledge base probably doesn't have good coverage for this topic. Escalating to a human agent is the safe, professional choice. You should also log this as a 'knowledge gap' to improve the knowledge base later."
        }
      ]
    },
    {
      "id": "M020-phase-6",
      "title": "Module 20: Phase 6 — Ticket Classification & Smart Routing",
      "stages": [
        {
          "type": "concept",
          "title": "Step 7: AI-Powered Ticket Classification",
          "content": {
            "title": "Step 7: AI-Powered Ticket Classification",
            "explanation": "When a customer sends a message, the first thing our system must do is **classify** it. Is it a billing question? A technical issue? A feature request? This classification determines:\n\n- Which **AI agent** handles it (Phase 9)\n- What **priority** to assign\n- Whether to **auto-resolve** or **escalate** to a human\n\n**Classification Approach:**\nWe'll use the LLM with structured output (remember Module 6 — prompt engineering and Module 5 — LLM APIs). Instead of free-text, we force the LLM to return a JSON object with our exact categories.\n\n**Why LLM classification vs. traditional ML?**\n- Traditional ML needs thousands of labeled examples to train\n- LLM classification works with zero-shot or few-shot prompting\n- LLMs understand nuance: 'I can't log in' → account_access, not technical_issue\n- Easy to add new categories without retraining\n\n**The trade-off:** LLM classification costs money per API call and is slower (~500ms vs ~5ms for a trained classifier). For our SaaS product, the accuracy improvement is worth it.",
            "example": "# app/services/classifier.py\nfrom langchain_openai import ChatOpenAI\nfrom pydantic import BaseModel, Field\nfrom typing import Optional\nimport structlog\nfrom app.config import get_settings\n\nlogger = structlog.get_logger()\nsettings = get_settings()\n\nclass TicketClassification(BaseModel):\n    \"\"\"Structured output for ticket classification.\"\"\"\n    category: str = Field(\n        description=\"One of: account, billing, technical, feature_request, bug_report, general\"\n    )\n    priority: str = Field(\n        description=\"One of: low, medium, high, urgent\"\n    )\n    sentiment: str = Field(\n        description=\"One of: positive, neutral, frustrated, angry\"\n    )\n    requires_human: bool = Field(\n        description=\"True if this requires human intervention (legal, refund > $100, threat)\"\n    )\n    confidence: float = Field(\n        description=\"Your confidence in this classification from 0.0 to 1.0\"\n    )\n    summary: str = Field(\n        description=\"One-sentence summary of the customer's issue\"\n    )\n\nCLASSIFY_PROMPT = \"\"\"Analyze this customer support message and classify it.\n\nCustomer Message: {message}\n\nClassify into:\n- category: account | billing | technical | feature_request | bug_report | general\n- priority: low (general info) | medium (needs help) | high (blocking issue) | urgent (data loss, security)\n- sentiment: positive | neutral | frustrated | angry\n- requires_human: true for legal issues, large refunds, threats, or abusive content\n- confidence: 0.0 to 1.0\n- summary: one-sentence summary\n\"\"\"\n\nclass ClassifierService:\n    def __init__(self):\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_MODEL,\n            api_key=settings.OPENAI_API_KEY,\n            temperature=0,  # Deterministic for classification\n        ).with_structured_output(TicketClassification)\n\n    async def classify(self, message: str) -> TicketClassification:\n        \"\"\"Classify a customer message.\"\"\"\n        try:\n            result = await self.llm.ainvoke(\n                CLASSIFY_PROMPT.format(message=message)\n            )\n            logger.info(\n                \"Ticket classified\",\n                category=result.category,\n                priority=result.priority,\n                confidence=result.confidence\n            )\n            return result\n        except Exception as e:\n            logger.error(\"Classification failed\", error=str(e))\n            # Fallback: return safe defaults\n            return TicketClassification(\n                category=\"general\",\n                priority=\"medium\",\n                sentiment=\"neutral\",\n                requires_human=True,  # When in doubt, escalate\n                confidence=0.0,\n                summary=\"Classification failed — requires human review\"\n            )"
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Create the POST /api/v1/tickets endpoint that: accepts a customer email and message, finds or creates the customer in PostgreSQL, classifies the message using ClassifierService, creates a Ticket record, generates an AI response using RAGEngine, saves the Message, and returns the full ticket with AI response. This is the main API endpoint for the entire platform.",
            "starterCode": "from fastapi import APIRouter, Depends, HTTPException\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom pydantic import BaseModel, EmailStr\nfrom app.db.postgres import get_db\nfrom app.services.classifier import ClassifierService\nfrom app.services.rag_engine import RAGEngine\nimport structlog\n\nrouter = APIRouter(prefix=\"/api/v1/tickets\", tags=[\"tickets\"])\nlogger = structlog.get_logger()\nclassifier = ClassifierService()\nrag_engine = RAGEngine()\n\nclass CreateTicketRequest(BaseModel):\n    customer_email: EmailStr\n    customer_name: str\n    message: str\n\n# TODO: Create POST / endpoint",
            "solution": "from fastapi import APIRouter, Depends, HTTPException, Request\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom sqlalchemy import select\nfrom pydantic import BaseModel, EmailStr\nfrom app.db.postgres import get_db\nfrom app.services.classifier import ClassifierService\nfrom app.services.rag_engine import RAGEngine\nfrom app.models.customer import Customer\nfrom app.models.ticket import Ticket, TicketStatus, TicketPriority, TicketCategory\nfrom app.models.message import Message\nimport structlog\n\nrouter = APIRouter(prefix=\"/api/v1/tickets\", tags=[\"tickets\"])\nlogger = structlog.get_logger()\nclassifier = ClassifierService()\nrag_engine = RAGEngine()\n\nclass CreateTicketRequest(BaseModel):\n    customer_email: EmailStr\n    customer_name: str\n    message: str\n\n@router.post(\"/\")\nasync def create_ticket(\n    request: CreateTicketRequest,\n    req: Request,\n    db: AsyncSession = Depends(get_db)\n):\n    \"\"\"Create a new support ticket with AI classification and response.\"\"\"\n    # 1. Find or create customer\n    result = await db.execute(\n        select(Customer).where(Customer.email == request.customer_email)\n    )\n    customer = result.scalar_one_or_none()\n\n    if not customer:\n        customer = Customer(email=request.customer_email, name=request.customer_name)\n        db.add(customer)\n        await db.flush()\n\n    # 2. Classify the message\n    classification = await classifier.classify(request.message)\n\n    # 3. Create ticket\n    ticket = Ticket(\n        customer_id=customer.id,\n        subject=classification.summary,\n        status=TicketStatus.ESCALATED if classification.requires_human else TicketStatus.OPEN,\n        priority=TicketPriority(classification.priority),\n        category=TicketCategory(classification.category),\n        ai_confidence=classification.confidence,\n    )\n    db.add(ticket)\n    await db.flush()\n\n    # 4. Save customer message\n    customer_msg = Message(\n        ticket_id=ticket.id,\n        role=\"customer\",\n        content=request.message\n    )\n    db.add(customer_msg)\n\n    # 5. Generate AI response (skip if escalated)\n    ai_response = None\n    if not classification.requires_human:\n        rag_result = await rag_engine.cached_query(\n            request.message, req.app.state.redis\n        )\n        ai_response = rag_result[\"answer\"]\n\n        ai_msg = Message(\n            ticket_id=ticket.id,\n            role=\"assistant\",\n            content=ai_response,\n            confidence=rag_result[\"confidence\"]\n        )\n        db.add(ai_msg)\n\n    await db.commit()\n\n    return {\n        \"ticket_id\": str(ticket.id),\n        \"classification\": classification.model_dump(),\n        \"ai_response\": ai_response,\n        \"status\": ticket.status.value,\n        \"requires_human\": classification.requires_human\n    }",
            "language": "python"
          }
        },
        {
          "type": "mcq",
          "questions": [
            {
              "question": "Why do we use temperature=0 for ticket classification but temperature=0.1 for RAG response generation?",
              "options": [
                "It doesn't matter — temperature is just for creativity",
                "Classification needs deterministic (same input = same output) results, while responses benefit from slight variation to sound more natural",
                "Higher temperature makes the AI more accurate",
                "Temperature=0 uses less API credits"
              ],
              "answer": 1,
              "explanation": "Classification is a structured task — 'billing' should always be 'billing' for the same message. Temperature=0 makes this deterministic. Response generation benefits from a tiny amount of variation (0.1) so responses don't sound robotic, while still staying factual."
            },
            {
              "question": "In the classifier's fallback (except block), why do we set requires_human=True?",
              "options": [
                "To save API costs",
                "Because the fail-safe principle says: when AI fails, default to human review rather than risk a bad automated response",
                "Because the AI always gets it wrong",
                "To test the escalation system"
              ],
              "answer": 1,
              "explanation": "This is the 'fail-safe' design pattern. If classification fails (API timeout, rate limit, etc.), we don't want to route the ticket to an automated response that might be wrong. Better to escalate to a human who can handle it correctly."
            }
          ]
        }
      ]
    },
    {
      "id": "M020-phase-7",
      "title": "Module 20: Phase 7 — LangGraph Multi-Agent Orchestration",
      "stages": [
        {
          "type": "concept",
          "title": "Step 8: Building the Agent System with LangGraph",
          "content": {
            "title": "Step 8: Building the Agent System with LangGraph",
            "explanation": "In Modules 11 and 12, you learned LangChain, LangGraph, and AI Agents. Now we'll build a **multi-agent system** where specialized agents handle different types of customer queries.\n\n**Why multiple agents instead of one?**\nA single 'do-everything' agent becomes unreliable as complexity grows. Specialized agents:\n- Have **focused prompts** (better accuracy)\n- Can use **different tools** (billing agent accesses payment APIs)\n- Are **independently testable**\n- Can be **upgraded** without affecting other agents\n\n**Our Agent Architecture:**\n```\nCustomer Query\n      ↓\n┌─────────────────┐\n│  Router Agent   │  ← Decides which specialist to use\n│  (Supervisor)   │\n└──┬──────┬───┬───┘\n   ↓      ↓   ↓\n┌──────┐ ┌──┐ ┌────────┐\n│Support│ │B │ │Technical│\n│Agent  │ │i │ │Agent   │\n│       │ │l │ │        │\n│Uses:  │ │l │ │Uses:   │\n│- RAG  │ │i │ │- RAG   │\n│- FAQ  │ │n │ │- Logs  │\n│       │ │g │ │- Docs  │\n└───────┘ └──┘ └────────┘\n              ↓\n         ┌────────┐\n         │Escalate│\n         │to Human│\n         └────────┘\n```\n\n**LangGraph Concepts Refresher:**\n- **State**: The data flowing through the graph (messages, metadata)\n- **Nodes**: Functions that process/transform state\n- **Edges**: Connections between nodes (can be conditional)\n- **Conditional Routing**: Route to different nodes based on state",
            "sections": [
              {
                "title": "Agent State Design",
                "body": "The shared state object carries everything agents need:\n\n```python\nfrom typing import TypedDict, Annotated, Literal\nfrom langgraph.graph import add_messages\nfrom langchain_core.messages import BaseMessage\n\nclass AgentState(TypedDict):\n    messages: Annotated[list[BaseMessage], add_messages]\n    ticket_id: str\n    category: str\n    priority: str\n    customer_tier: str\n    rag_context: str          # Retrieved knowledge base context\n    requires_escalation: bool\n    final_response: str\n    sources: list[dict]\n    confidence: float\n```\n\nThis state flows through every node in the graph. Each agent reads what it needs and writes its results back."
              }
            ],
            "example": "# app/agents/router_agent.py\nfrom langgraph.graph import StateGraph, END\nfrom langchain_openai import ChatOpenAI\nfrom app.agents.state import AgentState\nfrom app.agents.support_agent import support_node\nfrom app.agents.billing_agent import billing_node\nfrom app.agents.technical_agent import technical_node\nfrom app.agents.escalation import escalation_node\nfrom app.config import get_settings\nimport structlog\n\nlogger = structlog.get_logger()\nsettings = get_settings()\n\ndef route_to_agent(state: AgentState) -> str:\n    \"\"\"Route to the appropriate specialist agent based on category.\"\"\"\n    category = state[\"category\"]\n    requires_escalation = state.get(\"requires_escalation\", False)\n    \n    if requires_escalation:\n        return \"escalation\"\n    \n    routing_map = {\n        \"billing\": \"billing_agent\",\n        \"technical\": \"technical_agent\",\n        \"bug_report\": \"technical_agent\",\n        \"account\": \"support_agent\",\n        \"feature_request\": \"support_agent\",\n        \"general\": \"support_agent\",\n    }\n    \n    route = routing_map.get(category, \"support_agent\")\n    logger.info(\"Routing ticket\", category=category, agent=route)\n    return route\n\ndef build_agent_graph() -> StateGraph:\n    \"\"\"Build the multi-agent workflow graph.\"\"\"\n    graph = StateGraph(AgentState)\n    \n    # Add nodes\n    graph.add_node(\"support_agent\", support_node)\n    graph.add_node(\"billing_agent\", billing_node)\n    graph.add_node(\"technical_agent\", technical_node)\n    graph.add_node(\"escalation\", escalation_node)\n    \n    # Set entry point — conditional routing\n    graph.set_conditional_entry_point(\n        route_to_agent,\n        {\n            \"support_agent\": \"support_agent\",\n            \"billing_agent\": \"billing_agent\",\n            \"technical_agent\": \"technical_agent\",\n            \"escalation\": \"escalation\",\n        }\n    )\n    \n    # All agents end after processing\n    graph.add_edge(\"support_agent\", END)\n    graph.add_edge(\"billing_agent\", END)\n    graph.add_edge(\"technical_agent\", END)\n    graph.add_edge(\"escalation\", END)\n    \n    return graph.compile()\n\n# Create the compiled graph (singleton)\nagent_graph = build_agent_graph()"
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Create the support_agent node function. It should: take the AgentState, use the RAG engine to search for relevant knowledge, construct a support-specific prompt with the customer's tier and context, call the LLM, and update the state with the final_response, sources, and confidence. Enterprise customers should get more detailed responses.",
            "starterCode": "from langchain_openai import ChatOpenAI\nfrom app.agents.state import AgentState\nfrom app.services.rag_engine import RAGEngine\nfrom app.config import get_settings\nimport structlog\n\nlogger = structlog.get_logger()\nsettings = get_settings()\nrag = RAGEngine()\n\nSUPPORT_PROMPT = \"\"\"You are a senior customer support specialist.\n# TODO: Complete the prompt\n\"\"\"\n\nasync def support_node(state: AgentState) -> AgentState:\n    # TODO: Implement the support agent\n    pass",
            "solution": "from langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage\nfrom app.agents.state import AgentState\nfrom app.services.rag_engine import RAGEngine\nfrom app.config import get_settings\nimport structlog\n\nlogger = structlog.get_logger()\nsettings = get_settings()\nrag = RAGEngine()\nllm = ChatOpenAI(model=settings.OPENAI_MODEL, api_key=settings.OPENAI_API_KEY, temperature=0.2)\n\nSUPPORT_PROMPT = \"\"\"You are a senior customer support specialist.\nCustomer Tier: {tier}\n\n=== KNOWLEDGE BASE ===\n{context}\n=== END KNOWLEDGE BASE ===\n\nCustomer Question: {question}\n\nGuidelines:\n- For ENTERPRISE customers: provide detailed, step-by-step answers with proactive suggestions\n- For PRO customers: provide clear, complete answers\n- For FREE customers: provide helpful but concise answers, mention upgrade benefits if relevant\n- Always cite sources with [Source: filename]\n- If unsure, acknowledge the limitation and offer to escalate\n- Be warm, professional, and empathetic\n\"\"\"\n\nasync def support_node(state: AgentState) -> AgentState:\n    \"\"\"General support agent — handles account, feature requests, and general queries.\"\"\"\n    question = state[\"messages\"][-1].content\n    tier = state.get(\"customer_tier\", \"free\")\n\n    # Retrieve relevant context\n    rag_result = await rag.query(question, top_k=5)\n\n    prompt = SUPPORT_PROMPT.format(\n        tier=tier.upper(),\n        context=rag_result[\"answer\"],  # Use the full RAG pipeline output\n        question=question\n    )\n\n    response = await llm.ainvoke([HumanMessage(content=prompt)])\n\n    logger.info(\n        \"Support agent responded\",\n        confidence=rag_result[\"confidence\"],\n        tier=tier\n    )\n\n    return {\n        **state,\n        \"final_response\": response.content,\n        \"sources\": rag_result[\"sources\"],\n        \"confidence\": rag_result[\"confidence\"],\n        \"requires_escalation\": rag_result[\"confidence\"] < 0.5  # Low confidence → escalate\n    }",
            "language": "python"
          }
        },
        {
