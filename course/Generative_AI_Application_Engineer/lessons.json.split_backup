        {
          "type": "concept",
          "content": {
            "title": "Difference between RNN,LSTM and GRU ",
            "explanation": "This comparison shows how RNN, LSTM, and GRU differ in memory handling, learning capability, speed, complexity, and their ability to capture long-term dependencies in sequential data.",
            "html_code": "<div style='font-family:Arial,sans-serif;max-width:1000px;margin:auto;padding:20px;background:#ffffff;border:1px solid #d1d5db;border-radius:12px;'><h3 style='text-align:center;color:#111827;margin-bottom:20px;'>RNN vs LSTM vs GRU Comparison</h3><table style='width:100%;border-collapse:collapse;text-align:center;font-size:14px;color:#111827;'><tr style='background:#111827;color:white;'><th style='border:1px solid #374151;padding:12px;'>Feature</th><th style='border:1px solid #374151;padding:12px;'>RNN</th><th style='border:1px solid #374151;padding:12px;'>LSTM</th><th style='border:1px solid #374151;padding:12px;'>GRU</th></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Memory</td><td style='border:1px solid #d1d5db;padding:10px;'>Short-Term</td><td style='border:1px solid #d1d5db;padding:10px;'>Long-Term</td><td style='border:1px solid #d1d5db;padding:10px;'>Long-Term</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Gates</td><td style='border:1px solid #d1d5db;padding:10px;'>None</td><td style='border:1px solid #d1d5db;padding:10px;'>Forget, Input, Output</td><td style='border:1px solid #d1d5db;padding:10px;'>Update, Reset</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Training Speed</td><td style='border:1px solid #d1d5db;padding:10px;'>Fast</td><td style='border:1px solid #d1d5db;padding:10px;'>Medium</td><td style='border:1px solid #d1d5db;padding:10px;'>Fast</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Long Context Handling</td><td style='border:1px solid #d1d5db;padding:10px;'>Poor</td><td style='border:1px solid #d1d5db;padding:10px;'>Excellent</td><td style='border:1px solid #d1d5db;padding:10px;'>Very Good</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Vanishing Gradient</td><td style='border:1px solid #d1d5db;padding:10px;'>High</td><td style='border:1px solid #d1d5db;padding:10px;'>Solved</td><td style='border:1px solid #d1d5db;padding:10px;'>Solved</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Complexity</td><td style='border:1px solid #d1d5db;padding:10px;'>Low</td><td style='border:1px solid #d1d5db;padding:10px;'>High</td><td style='border:1px solid #d1d5db;padding:10px;'>Medium</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Parameters</td><td style='border:1px solid #d1d5db;padding:10px;'>Few</td><td style='border:1px solid #d1d5db;padding:10px;'>Many</td><td style='border:1px solid #d1d5db;padding:10px;'>Fewer than LSTM</td></tr><tr><td style='border:1px solid #d1d5db;padding:10px;font-weight:bold;background:#f3f4f6;'>Best Use Case</td><td style='border:1px solid #d1d5db;padding:10px;'>Short Sequences</td><td style='border:1px solid #d1d5db;padding:10px;'>Long Sequences</td><td style='border:1px solid #d1d5db;padding:10px;'>Efficient Sequence Learning</td></tr></table></div>"
          }
        },
