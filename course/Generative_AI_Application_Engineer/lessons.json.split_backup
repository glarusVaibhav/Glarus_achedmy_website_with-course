          "type": "code",
          "challenge": {
            "title": "Hands-On: Product Information Extractor",
            "difficulty": "Easy",
            "question": "You are building an online shopping application. Complete the prompt so the LLM extracts product information into the specified JSON schema.",
            "starterCode": "import json\nfrom openai import OpenAI\nclient = OpenAI()\n\nproduct_text = \"Apple iPhone 15 Pro costs $999 and comes with 256GB storage.\"\n\ndef extract_product(text):\n    # TODO: Write the prompt below.\n    prompt = f\"\"\"    [Write your prompt here]   \"\"\"\n\n    response = client.chat.completions.create(\n        model=\"gpt-4o-mini\",\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        response_format={\"type\": \"json_object\"}\n    )\n\n    return response.choices[0].message.content",
            "language": "python",
            "expected_output": "{\n  \"product_name\": \"Apple iPhone 15 Pro\",\n  \"price\": 999,\n  \"storage\": \"256GB\"\n}",
            "hint": "Provide the exact JSON schema inside your prompt and instruct the model to return only valid JSON.",
            "solution": "import json\nfrom openai import OpenAI\nclient = OpenAI()\n\nproduct_text = \"Apple iPhone 15 Pro costs $999 and comes with 256GB storage.\"\n\ndef extract_product(text):\n    # TODO: Write the prompt below.\n    prompt = \"\"\"    You are an information extraction assistant.\n\nExtract the product details from the text below.\n\nReturn ONLY a valid JSON object using this exact schema:\n{\n  'product_name': ' ',\n  'price': 0,\n  'storage': ' '\n}\n\nDo not return explanations or markdown.\n\nProduct Description:\n{text}    \"\"\"\n\n    response = client.chat.completions.create(\n        model=\"gpt-4o-mini\",\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        response_format={\"type\": \"json_object\"}\n    )\n\n    return response.choices[0].message.content"
          }
        },
        {
          "type": "code",
          "challenge": {
            "title": "Hands-On: Receipt Information Extractor",
            "difficulty": "Easy",
            "question": "A coffee shop wants to digitize printed receipts. Complete the prompt so the LLM extracts the store name and total amount into the specified JSON schema.",
            "starterCode": "import json\nfrom openai import OpenAI\nclient = OpenAI()\n\nreceipt_text = \"Star Coffee. Date: 2025-11-12. Items: Latte x2, Blueberry Muffin x1. Total: $18.50. Thank you for visiting!\"\n\ndef extract_receipt(text):\n    # TODO: Write the prompt below.\n    prompt = f\"\"\"    [Write your prompt here]    \"\"\"\n\n    response = client.chat.completions.create(\n        model=\"gpt-4o-mini\",\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        response_format={\"type\": \"json_object\"}\n    )\n\n    return response.choices[0].message.content",
            "language": "python",
            "expected_output": "{\n  \"store_name\": \"Star Coffee\",\n  \"total_amount\": \"$18.50\"\n}",
            "hint": "Provide the exact JSON schema inside your prompt and instruct the model to return only valid JSON.",
            "solution": "import json\nfrom openai import OpenAI\nclient = OpenAI()\n\nreceipt_text = \"Star Coffee. Date: 2025-11-12. Items: Latte x2, Blueberry Muffin x1. Total: $18.50. Thank you for visiting!\"\n\ndef extract_receipt(text):\n    # TODO: Write the prompt below.\n    prompt = \"\"\"You are an information extraction assistant.\n\nExtract the receipt details from the text below.\n\nReturn ONLY a valid JSON object using this exact schema:\n{{\n  \"store_name\": \"\",\n  \"total_amount\": \"\"\n}}\n\nDo not return explanations or markdown.\n\nReceipt:\n{text}\n\"\"\"\n\n    response = client.chat.completions.create(\n        model=\"gpt-4o-mini\",\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        response_format={\"type\": \"json_object\"}\n    )\n\n    return response.choices[0].message.content"
          }
        },
        {
