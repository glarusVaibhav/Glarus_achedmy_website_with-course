            "solution": "response = client.chat.completions.create(\n model='gpt-4o-mini',\n messages=[{\n 'role':'user',\n 'content':f'Summarize this text:\\n{text}'\n }]\n)\n\nprint(response.choices[0].message.content)",
            "language": "python",
            "hint": "Use the word 'Summarize' in the prompt.",
            "explanation": "The model reads the document and generates a concise summary."
          }
