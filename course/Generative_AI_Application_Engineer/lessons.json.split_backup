        {
          "type": "scenario",
          "content": {
            "title": "Docker Strategy Decision",
            "scenario": "Your AI startup has a FastAPI chatbot that uses OpenAI's API, stores conversation history in PostgreSQL, caches responses in Redis, and uses Qdrant for RAG document search. The development team has 3 developers, each with different OS (Windows, macOS, Linux). Deployments currently break 40% of the time due to environment differences.",
            "options": [
