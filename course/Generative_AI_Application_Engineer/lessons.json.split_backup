          "type": "mcq",
          "questions": [
            {
              "question": "What is the key difference between a Tool and a Retriever in LangChain? (Select the correct option)",
              "options": [
                "Tools are faster than Retrievers",
                "Retrievers always run in the chain; Tools are optionally called by the LLM",
                "Tools work with text, Retrievers work with images",
                "Retrievers are for local data, Tools are for cloud data"
