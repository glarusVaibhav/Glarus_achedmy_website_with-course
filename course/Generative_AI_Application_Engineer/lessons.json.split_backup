                "label": "Example",
                "code": "from pydantic import BaseModel\n\nclass UserProfile(BaseModel):\n    name: str             # Required\n    age: int              # Required, must be a number\n    email: str            # Required\n    is_premium: bool = False  # Optional, defaults to False"
