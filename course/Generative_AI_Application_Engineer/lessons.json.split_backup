            "starterCode": "import json\n\ndef llm_call(prompt):\n    # Mock: returns a JSON string of sub-tasks\n    return '[\"Step 1: Research topic\", \"Step 2: Write outline\", \"Step 3: Write draft\"]'\n\ndef create_plan(user_goal):\n    prompt = f'Break this task into sub-tasks as a JSON array: {user_goal}'\n    \n    # TODO: Call llm_call, parse JSON, create plan list\n    response = ___\n    steps = ___\n    \n    plan = []\n    for step in steps:\n        plan.append({'task': ___, 'status': '___'})\n    \n    return plan\n\nplan = create_plan('Write a blog post about AI')\nfor p in plan:\n    print(f\"[{p['status']}] {p['task']}\")",
            "solution": "import json\n\ndef llm_call(prompt):\n    return '[\"Step 1: Research topic\", \"Step 2: Write outline\", \"Step 3: Write draft\"]'\n\ndef create_plan(user_goal):\n    prompt = f'Break this task into sub-tasks as a JSON array: {user_goal}'\n    \n    response = llm_call(prompt)\n    steps = json.loads(response)\n    \n    plan = []\n    for step in steps:\n        plan.append({'task': step, 'status': 'pending'})\n    \n    return plan\n\nplan = create_plan('Write a blog post about AI')\nfor p in plan:\n    print(f\"[{p['status']}] {p['task']}\")",
