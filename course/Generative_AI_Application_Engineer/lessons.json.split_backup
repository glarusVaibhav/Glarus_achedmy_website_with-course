            "starterCode": "from transformers import TrainingArguments\n\ntraining_args = TrainingArguments(\n    output_dir=___,\n    deepspeed=___,\n    per_device_train_batch_size=___,\n    gradient_accumulation_steps=___,\n    num_train_epochs=___,\n    learning_rate=___\n)",
