            "starterCode": "import os\nfrom langsmith import traceable\n\n# Configure LangSmith\nos.environ['LANGCHAIN_TRACING_V2'] = ___\nos.environ['LANGCHAIN_API_KEY'] = ___\nos.environ['LANGCHAIN_PROJECT'] = ___\n\n@traceable\ndef answer_question(question: str) -> str:\n    # This function is now automatically traced!\n    return f'Answer to: {question}'",
