            ],
            "codePanel": {
              "title": "FastAPI Code",
              "code": "from fastapi import FastAPI\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\nclass ChatRequest(BaseModel):\n    message: str\n    model: str = 'gpt-4o-mini'\n\n@app.post('/chat')\nasync def chat(req: ChatRequest):\n    response = await ai_model(\n        req.message\n    )\n    return {'response': response}"
            },
            "typeFlowPanel": {
