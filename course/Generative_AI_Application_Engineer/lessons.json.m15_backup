        {
          "type": "mcq",
          "questions": [
            {
              "question": "Why is Prompt Chaining generally preferred over a single 'Megaprompt' for complex tasks?",
              "options": [
                "Because LLMs process smaller prompts faster, reducing latency to zero.",
                "Because dividing the task into smaller, isolated steps reduces cognitive overload on the model, minimizes hallucinations, and allows developers to validate data at each stage.",
                "Because Megaprompts cannot accept JSON formatting constraints.",
                "Because OpenAI and other API providers ban prompts longer than 500 words."
              ],
              "answer": 1,
              "explanation": "Chaining breaks complex logic down into manageable nodes. This prevents the LLM from 'forgetting' earlier instructions in a long prompt and allows you to catch errors before they corrupt the final output."
            },
            {
              "question": "What is the primary purpose of placing user input inside delimiters like ``` or <data> tags?",
              "options": [
                "To make the code look prettier for developers reading the logs.",
                "To automatically trigger JSON output mode.",
                "To clearly separate trusted system instructions from untrusted user data, mitigating prompt injection attacks.",
                "To compress the token count of the prompt."
              ],
              "answer": 2,
              "explanation": "Delimiters create a structural boundary. By telling the system prompt 'Only translate what is inside the <data> tags,' you isolate the user's text, preventing the LLM from accidentally interpreting user text as a new system command."
            }
          ]
