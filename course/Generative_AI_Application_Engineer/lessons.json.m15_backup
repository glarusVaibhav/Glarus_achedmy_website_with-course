            "starterCode": "def is_valid_alpaca(data: dict) -> bool:\n    '''Validate if a dictionary has correct Alpaca format.'''\n    required_keys = ['instruction', 'input', 'output']\n    # Check all keys exist AND values are non-empty\n    ___",
            "solution": "def is_valid_alpaca(data: dict) -> bool:\n    '''Validate if a dictionary has correct Alpaca format.'''\n    required_keys = ['instruction', 'input', 'output']\n    return all(key in data and data[key].strip() for key in required_keys)",
