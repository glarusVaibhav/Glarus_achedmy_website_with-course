                      "Zero LLM cost",
                      "100% match required"
                    ]
                  }
                ]
              },
              {
                "id": "cache-l2",
                "name": "Level 2: Semantic Cache",
                "badge": "Smart",
                "packages": [
                  {
                    "id": "semantic-cache",
                    "label": "pgvector / Qdrant",
                    "items": [
                      "Embedding similarity search",
                      "Catches paraphrased queries",
