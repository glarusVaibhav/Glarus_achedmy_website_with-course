          "type": "code",
          "challenge": {
            "question": "Build a Text Summarizer.",
            "starterCode": "article = 'Long article here...'\n",
            "solution": "response = client.chat.completions.create(\n model='gpt-4o-mini',\n messages=[{\n 'role':'user',\n 'content':f'Summarize this article in 50 words:\\n{article}'\n }]\n)\n\nprint(response.choices[0].message.content)",
            "language": "python",
            "hint": "Use the word 'Summarize' in your prompt.",
            "explanation": "The model condenses the article into a concise summary."
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Project 3: AI Q&A Assistant",
            "explanation": "Build an assistant that answers user questions.\n\n**Skills Learned:**\n• User Input Handling\n• Prompt Design\n• Response Generation\n\n**Workflow:**\nQuestion → GPT → Answer",
            "example": "Question: What is Machine Learning?\nAnswer: Machine Learning is a branch of AI that learns patterns from data.",
            "tip": "Ask clear questions for accurate answers."
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Build a Q&A Assistant.",
            "starterCode": "question = input('Ask a question: ')\n",
            "solution": "response = client.chat.completions.create(\n model='gpt-4o-mini',\n messages=[{'role':'user','content':question}]\n)\n\nprint(response.choices[0].message.content)",
            "language": "python",
            "hint": "Send the user's question directly to the model.",
            "explanation": "The model generates an answer to the user's question."
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Project 4: BERT Question Answering App",
            "explanation": "Unlike GPT APIs, this project uses a local Hugging Face BERT model for question answering.\n\n**Required Libraries:**\n`pip install transformers torch`\n\n**Workflow:**\nContext + Question → BERT Model → Answer",
            "example": "Context: 'Python was created by Guido van Rossum.'\nQuestion: 'Who created Python?'\nAnswer: 'Guido van Rossum'",
            "tip": "BERT is optimized for understanding text, not generating long responses."
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Build a BERT Question Answering App.",
            "starterCode": "from transformers import pipeline\n",
            "solution": "from transformers import pipeline\n\nqa = pipeline('question-answering')\n\nresult = qa(\n question='Who created Python?',\n context='Python was created by Guido van Rossum.'\n)\n\nprint(result['answer'])",
            "language": "python",
            "hint": "Use the question-answering pipeline.",
            "explanation": "BERT extracts the answer from the provided context."
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Project 5: Simple ChatGPT Clone",
            "explanation": "Build a chatbot that remembers conversation history.\n\n**Skills Learned:**\n• Chat Interfaces\n• Conversation Memory\n• Multi-turn Interactions\n\n**Workflow:**\nUser Message → Message History → GPT → Response → Store History",
            "example": "User: Hello\nBot: Hi! How can I help you?\nUser: Tell me about AI\nBot: AI stands for Artificial Intelligence...",
            "tip": "Store both user and assistant messages in the conversation history."
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Build a Simple ChatGPT Clone.",
            "starterCode": "messages = []\n",
            "solution": "messages=[]\n\nwhile True:\n user=input('You: ')\n\n messages.append({'role':'user','content':user})\n\n response=client.chat.completions.create(\n model='gpt-4o-mini',\n messages=messages\n )\n\n reply=response.choices[0].message.content\n print('Bot:',reply)\n\n messages.append({'role':'assistant','content':reply})",
            "language": "python",
            "hint": "Store every message in the messages list.",
            "explanation": "Conversation history helps the model maintain context."
          }
        }
      ]
