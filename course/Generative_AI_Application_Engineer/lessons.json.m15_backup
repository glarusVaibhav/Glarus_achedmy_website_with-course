        {
          "type": "mcq",
          "questions": [
            {
              "question": "What happens when a node returns {'messages': [new_msg]} and the messages field does NOT have a reducer? (Select the correct option)",
              "options": [
                "The new message is appended to the existing messages list",
                "The entire messages list is REPLACED with [new_msg]",
