        {
          "type": "code",
          "challenge": {
            "question": "Create a list called `fruits` with three fruit names, a tuple called `resolution` with values 1920 and 1080, a set called `languages` containing 'Python', 'Java', and 'Python', and a dictionary called `student` with name 'John' and age 21. Then print the second fruit, the width from the tuple, and the student's age.",
            "starterCode": "# Write your code below:\n",
            "solution": "fruits = ['Apple', 'Banana', 'Mango']\nresolution = (1920, 1080)\nlanguages = {'Python', 'Java', 'Python'}\nstudent = {'name': 'John', 'age': 21}\n\nprint(fruits[1])\nprint(resolution[0])\nprint(student['age'])",
            "language": "python",
            "hint": "Use [] for lists, () for tuples, {} for sets and dictionaries. Access values using indexing or keys."
          }
