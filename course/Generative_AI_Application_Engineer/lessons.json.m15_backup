{
  "lessons": [
    {
      "id": "M000-course-overview",
      "title": "Course Overview",
      "stages": [
        {
          "type": "concept",
          "content": {
            "title": "Welcome to Generative AI Application Engineer",
            "explanation": "",
            "audio": "Welcome to the Generative AI Application Engineer course. Become a professional AI engineer. Build real AI products that companies actually use.",
            "html_code": "<style>\n  @keyframes floatUp { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }\n  @keyframes floatDown { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(15px); } }\n  @keyframes pulseGlow { 0%, 100% { opacity: 0.5; transform: scale(1); filter: blur(40px); } 50% { opacity: 0.8; transform: scale(1.1); filter: blur(50px); } }\n  @keyframes shimmer { 0% { background-position: -200% center; } 100% { background-position: 200% center; } }\n  @keyframes textGlow { 0%, 100% { text-shadow: 0 0 20px rgba(139,92,246,0.3); } 50% { text-shadow: 0 0 40px rgba(139,92,246,0.6), 0 0 10px rgba(255,255,255,0.4); } }\n  @keyframes slideInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes orbit { 0% { transform: rotate(0deg) translateX(120px) rotate(0deg); } 100% { transform: rotate(360deg) translateX(120px) rotate(-360deg); } }\n  @keyframes orbitReverse { 0% { transform: rotate(360deg) translateX(160px) rotate(-360deg); } 100% { transform: rotate(0deg) translateX(160px) rotate(0deg); } }\n  .glass-panel {\n    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.01) 100%);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid rgba(255,255,255,0.1);\n    box-shadow: 0 32px 64px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.15);\n  }\n  .stat-card {\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    background: linear-gradient(180deg, rgba(30,30,40,0.6) 0%, rgba(20,20,30,0.8) 100%);\n    border: 1px solid rgba(255,255,255,0.08);\n    backdrop-filter: blur(12px);\n  }\n  .stat-card:hover {\n    transform: translateY(-10px) scale(1.02);\n    border-color: rgba(139,92,246,0.5);\n    box-shadow: 0 20px 40px rgba(139,92,246,0.2), inset 0 0 20px rgba(139,92,246,0.1);\n  }\n</style>\n<div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;padding:40px 0 80px 0;position:relative;width:100%;\">\n  <!-- Background Orbs -->\n  <div style=\"position:absolute;top:10%;left:15%;width:400px;height:400px;background:#8b5cf6;border-radius:50%;opacity:0.12;filter:blur(80px);animation:pulseGlow 10s infinite alternate;pointer-events:none;\"></div>\n  <div style=\"position:absolute;bottom:20%;right:15%;width:500px;height:500px;background:#3b82f6;border-radius:50%;opacity:0.08;filter:blur(100px);animation:pulseGlow 12s infinite alternate-reverse;pointer-events:none;\"></div>\n  <div style=\"position:absolute;top:40%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;background:#ec4899;border-radius:50%;opacity:0.05;filter:blur(120px);animation:pulseGlow 15s infinite alternate;pointer-events:none;\"></div>\n  <!-- Top Badge -->\n  <div style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 24px;border-radius:100px;background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.3);margin-bottom:32px;animation:slideInUp 0.8s ease-out forwards;\">\n    <span style=\"display:flex;width:10px;height:10px;border-radius:50%;background:#10b981;box-shadow:0 0 12px #10b981, 0 0 20px #10b981;position:relative;\">\n      <span style=\"position:absolute;top:0;left:0;right:0;bottom:0;border-radius:50%;background:#10b981;animation:pulseGlow 2s infinite;\"></span>\n    </span>\n    <span style=\"font-size:13px;font-weight:800;color:#c4b5fd;letter-spacing:0.15em;text-transform:uppercase;\">Enrollment Open · 2025 Cohort</span>\n  </div>\n  <!-- Hero Headlines -->\n  <div style=\"max-width:800px;margin-bottom:64px;position:relative;z-index:10;animation:slideInUp 1s ease-out forwards;\">\n    <h1 style=\"font-size:clamp(48px, 6vw, 72px);font-weight:900;line-height:1.15;margin:0 0 24px 0;letter-spacing:-0.03em;\">\n      <span style=\"color:#ffffff;\">The Era of</span><br/>\n      <span style=\"background:linear-gradient(225deg, #c4b5fd 0%, #8b5cf6 40%, #3b82f6 70%, #06b6d4 100%);background-size:200% auto;color:transparent;-webkit-background-clip:text;background-clip:text;animation:shimmer 6s linear infinite, textGlow 4s ease-in-out infinite;display:inline-block;padding:4px 0;\">AI Engineering</span>\n      <span style=\"color:#ffffff;\"> is Here.</span>\n    </h1>\n    <p style=\"font-size:clamp(18px, 2vw, 22px);color:rgba(255,255,255,0.7);line-height:1.6;margin:0 auto;font-weight:400;max-width:680px;\">\n      Don't just use AI. <strong style=\"color:#ffffff;font-weight:600;\">Build it.</strong> Master LLMs, RAG, Agents, and production deployment in a single, comprehensive bootcamp.\n    </p>\n  </div>\n  <!-- Massive Interactive 3D Mockup Container -->\n  <div style=\"position:relative;width:100%;max-width:1000px;height:450px;margin-bottom:80px;perspective:1200px;animation:slideInUp 1.2s ease-out forwards;z-index:5;\">\n    <!-- Main Floating IDE Window -->\n    <div class=\"glass-panel\" style=\"position:absolute;top:50%;left:50%;transform:translate(-50%, -50%) rotateX(8deg);width:85%;height:100%;border-radius:24px;display:flex;flex-direction:column;overflow:hidden;transition:transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);\" onmouseover=\"this.style.transform='translate(-50%, -50%) rotateX(0deg) scale(1.03)'\" onmouseout=\"this.style.transform='translate(-50%, -50%) rotateX(8deg) scale(1)'\">\n      <!-- IDE Header -->\n      <div style=\"height:44px;background:rgba(0,0,0,0.4);border-bottom:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;padding:0 24px;gap:8px;\">\n        <div style=\"width:12px;height:12px;border-radius:50%;background:#ef4444;box-shadow:0 0 10px rgba(239,68,68,0.5);\"></div>\n        <div style=\"width:12px;height:12px;border-radius:50%;background:#eab308;box-shadow:0 0 10px rgba(234,179,8,0.5);\"></div>\n        <div style=\"width:12px;height:12px;border-radius:50%;background:#10b981;box-shadow:0 0 10px rgba(16,185,129,0.5);\"></div>\n        <div style=\"margin-left:auto;font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;font-size:13px;font-weight:500;color:rgba(255,255,255,0.4);\">agent_swarm.py</div>\n      </div>\n      <!-- IDE Content area -->\n      <div style=\"flex:1;display:flex;position:relative;\">\n        <!-- Left: Code Editor -->\n        <div style=\"flex:1.2;padding:32px 28px;font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;font-size:15px;line-height:1.7;color:#a8b2d1;text-align:left;position:relative;z-index:2;background:rgba(15,15,25,0.4);\">\n          <div><span style=\"color:#c678dd;\">from</span> langgraph.graph <span style=\"color:#c678dd;\">import</span> StateGraph</div>\n          <div><span style=\"color:#c678dd;\">from</span> agents <span style=\"color:#c678dd;\">import</span> Coder, Reviewer</div>\n          <br/>\n          <div><span style=\"color:#7a819e;font-style:italic;\"># Define the multi-agent production workflow</span></div>\n          <div>workflow = StateGraph(AgentState)</div>\n          <div>workflow.add_node(<span style=\"color:#98c379;\">\"coder\"</span>, Coder())</div>\n          <div>workflow.add_node(<span style=\"color:#98c379;\">\"reviewer\"</span>, Reviewer())</div>\n          <br/>\n          <div>workflow.add_conditional_edges(</div>\n          <div style=\"padding-left:24px;\"><span style=\"color:#98c379;\">\"reviewer\"</span>,</div>\n          <div style=\"padding-left:24px;\">check_quality,</div>\n          <div style=\"padding-left:24px;\">{ <span style=\"color:#98c379;\">\"pass\"</span>: <span style=\"color:#98c379;\">\"deploy\"</span>, <span style=\"color:#98c379;\">\"fail\"</span>: <span style=\"color:#98c379;\">\"coder\"</span> }</div>\n          <div>)</div>\n          <br/>\n          <div style=\"display:flex;align-items:center;gap:10px;margin-top:20px;padding:12px 16px;background:rgba(97,175,239,0.1);border-radius:8px;border:1px solid rgba(97,175,239,0.2);\">\n            <span style=\"width:8px;height:8px;border-radius:50%;background:#61afef;animation:pulseGlow 1.5s infinite;\"></span>\n            <span style=\"color:#61afef;font-weight:600;font-size:13px;\">Deploying autonomous agent swarm...</span>\n          </div>\n        </div>\n        <!-- Right: Visualizer / Output -->\n        <div style=\"flex:1;background:rgba(5,5,10,0.5);border-left:1px solid rgba(255,255,255,0.05);position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;\">\n          <div style=\"position:absolute;inset:0;background:radial-gradient(circle at center, rgba(139,92,246,0.15) 0%, transparent 70%);\"></div>\n          <!-- Central glowing core -->\n          <div style=\"width:120px;height:120px;border-radius:50%;background:rgba(139,92,246,0.1);border:2px solid rgba(139,92,246,0.5);box-shadow:0 0 50px rgba(139,92,246,0.4), inset 0 0 30px rgba(139,92,246,0.3);display:flex;align-items:center;justify-content:center;position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);z-index:2;animation:pulseGlow 4s infinite alternate;\">\n            <div style=\"font-size:56px;filter:drop-shadow(0 0 15px rgba(255,255,255,0.8));\">🧠</div>\n          </div>\n          <!-- Orbiting nodes -->\n          <div style=\"position:absolute;top:50%;left:50%;width:1px;height:1px;\">\n            <div style=\"position:absolute;top:-20px;left:-20px;width:40px;height:40px;background:rgba(30,30,40,0.8);border:1px solid rgba(59,130,246,0.5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 20px rgba(59,130,246,0.4);animation:orbit 8s linear infinite;\">🐍</div>\n            <div style=\"position:absolute;top:-20px;left:-20px;width:40px;height:40px;background:rgba(30,30,40,0.8);border:1px solid rgba(16,185,129,0.5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 20px rgba(16,185,129,0.4);animation:orbitReverse 12s linear infinite;\">⚡</div>\n            <div style=\"position:absolute;top:-20px;left:-20px;width:40px;height:40px;background:rgba(30,30,40,0.8);border:1px solid rgba(236,72,153,0.5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 20px rgba(236,72,153,0.4);animation:orbit 10s linear infinite;animation-delay:-5s;\">🦜</div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <!-- Floating accent cards -->\n    <div class=\"glass-panel\" style=\"position:absolute;top:-10px;left:0;padding:16px 24px;border-radius:16px;display:flex;align-items:center;gap:14px;animation:floatUp 6s ease-in-out infinite;z-index:10;box-shadow:0 24px 48px rgba(0,0,0,0.5);\">\n      <div style=\"width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg, #3b82f6, #2563eb);display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 0 20px rgba(59,130,246,0.4);\">🚀</div>\n      <div style=\"text-align:left;\">\n        <div style=\"font-size:15px;font-weight:800;color:#ffffff;letter-spacing:-0.01em;\">Production Ready</div>\n        <div style=\"font-size:13px;font-weight:500;color:rgba(255,255,255,0.5);\">Deploy to Cloud</div>\n      </div>\n    </div>\n    <div class=\"glass-panel\" style=\"position:absolute;bottom:-10px;right:0;padding:16px 24px;border-radius:16px;display:flex;align-items:center;gap:14px;animation:floatDown 7s ease-in-out infinite;z-index:10;box-shadow:0 24px 48px rgba(0,0,0,0.5);\">\n      <div style=\"width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg, #10b981, #059669);display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 0 20px rgba(16,185,129,0.4);\">🎯</div>\n      <div style=\"text-align:left;\">\n        <div style=\"font-size:15px;font-weight:800;color:#ffffff;letter-spacing:-0.01em;\">15+ Projects</div>\n        <div style=\"font-size:13px;font-weight:500;color:rgba(255,255,255,0.5);\">Real-world Portfolio</div>\n      </div>\n    </div>\n  </div>\n  <!-- Premium Stats Row -->\n  <div style=\"display:grid;grid-template-columns:repeat(4, 1fr);gap:20px;width:100%;max-width:960px;position:relative;z-index:10;animation:slideInUp 1.4s ease-out forwards;\">\n    <div class=\"stat-card\" style=\"border-radius:24px;padding:36px 24px;display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"font-size:clamp(40px,5vw,56px);font-weight:900;background:linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);-webkit-background-clip:text;color:transparent;margin-bottom:8px;line-height:1;letter-spacing:-0.02em;\">20+</div>\n      <div style=\"font-size:12px;color:#a1a1aa;font-weight:800;letter-spacing:0.25em;text-transform:uppercase;\">Modules</div>\n    </div>\n    <div class=\"stat-card\" style=\"border-radius:24px;padding:36px 24px;display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"font-size:clamp(40px,5vw,56px);font-weight:900;background:linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);-webkit-background-clip:text;color:transparent;margin-bottom:8px;line-height:1;letter-spacing:-0.02em;\">120+</div>\n      <div style=\"font-size:12px;color:#a1a1aa;font-weight:800;letter-spacing:0.25em;text-transform:uppercase;\">Challenges</div>\n    </div>\n    <div class=\"stat-card\" style=\"border-radius:24px;padding:36px 24px;display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"font-size:clamp(40px,5vw,56px);font-weight:900;background:linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);-webkit-background-clip:text;color:transparent;margin-bottom:8px;line-height:1;letter-spacing:-0.02em;\">15+</div>\n      <div style=\"font-size:12px;color:#a1a1aa;font-weight:800;letter-spacing:0.25em;text-transform:uppercase;\">Projects</div>\n    </div>\n    <div class=\"stat-card\" style=\"border-radius:24px;padding:36px 24px;display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"font-size:clamp(40px,5vw,56px);font-weight:900;background:linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);-webkit-background-clip:text;color:transparent;margin-bottom:8px;line-height:1;letter-spacing:-0.02em;\">50+</div>\n      <div style=\"font-size:12px;color:#a1a1aa;font-weight:800;letter-spacing:0.25em;text-transform:uppercase;\">Hours</div>\n    </div>\n  </div>\n</div>"
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "The Future is AI",
            "explanation": "",
            "audio": "The AI revolution is here. Companies are hiring AI engineers faster than universities can produce them. The average Generative AI engineer earns significantly more than traditional developers.",
            "html_code": "<style>\n  @keyframes imageZoom { 0%, 100% { transform: scale(1); filter: brightness(0.9); } 50% { transform: scale(1.05); filter: brightness(1.1); } }\n  @keyframes cardGlow { 0%, 100% { box-shadow: 0 0 0 rgba(139,92,246,0); } 50% { box-shadow: 0 0 30px rgba(139,92,246,0.15); } }\n</style>\n<div style=\"padding:16px 0;\">\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;\">\n    <div style=\"display:flex;flex-direction:column;gap:24px;\">\n      <div style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(249,115,22,0.15);color:#f97316;\">Why Now</div>\n      <h2 style=\"font-size:clamp(28px,3.5vw,42px);font-weight:800;color:#ffffff;letter-spacing:-0.02em;line-height:1.1;margin:0;\">\n        The AI opportunity<br/>won't wait for you.\n      </h2>\n      <p style=\"font-size:17px;color:rgba(255,255,255,0.6);line-height:1.7;margin:0;max-width:480px;\">\n        Companies are hiring AI engineers faster than universities can produce them. The average Generative AI engineer earns significantly more than traditional developers. This isn't hype — it's the biggest shift in technology since the internet.\n      </p>\n      <div style=\"display:flex;gap:24px;margin-top:8px;\">\n        <div>\n          <div style=\"font-size:32px;font-weight:800;color:#10b981;\">10x</div>\n          <div style=\"font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px;\">Demand growth</div>\n        </div>\n        <div style=\"width:1px;background:rgba(255,255,255,0.08);\"></div>\n        <div>\n          <div style=\"font-size:32px;font-weight:800;color:#3b82f6;\">$180k+</div>\n          <div style=\"font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px;\">Avg. salary</div>\n        </div>\n        <div style=\"width:1px;background:rgba(255,255,255,0.08);\"></div>\n        <div>\n          <div style=\"font-size:32px;font-weight:800;color:#a855f7;\">92%</div>\n          <div style=\"font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px;\">Companies adopting AI</div>\n        </div>\n      </div>\n    </div>\n    <div style=\"position:relative;min-height:320px;border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;animation:cardGlow 5s ease-in-out infinite;\">\n      <img src=\"/images/ai_industry_future.png\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;animation:imageZoom 10s ease-in-out infinite;z-index:1;\" alt=\"AI Future\" />\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to top, rgba(5,5,10,0.95) 0%, rgba(5,5,10,0.2) 50%, rgba(5,5,10,0.8) 100%);z-index:2;\"></div>\n      <div style=\"position:absolute;bottom:0;left:0;right:0;padding:24px 28px;z-index:3;\">\n        <div style=\"font-size:16px;font-weight:600;color:#ffffff;\">AI is reshaping every industry.</div>\n        <div style=\"font-size:14px;color:rgba(255,255,255,0.6);margin-top:6px;\">Those who build it will lead the future.</div>\n      </div>\n    </div>\n  </div>\n</div>"
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Your Transformation",
            "explanation": "",
            "audio": "Imagine yourself after completing this course. You will go from no Python knowledge to a professional AI engineer with 15 plus production-ready projects in your portfolio.",
            "html_code": "<div style=\"padding:16px 0;\">\n  <div style=\"text-align:center;margin-bottom:48px;\">\n    <div style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(16,185,129,0.15);color:#10b981;margin-bottom:16px;\">Your Transformation</div>\n    <h2 style=\"font-size:clamp(28px,4vw,40px);font-weight:800;background:linear-gradient(135deg, #c4b5fd 0%, #8b5cf6 50%, #3b82f6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:-0.02em;line-height:1.15;margin:0 0 16px 0;text-align:center;\">Imagine yourself<br/>after this course.</h2>\n    <p style=\"font-size:clamp(16px,2vw,20px);color:rgba(255,255,255,0.5);text-align:center;max-width:640px;margin:0 auto 48px auto;line-height:1.6;font-weight:400;\">This isn't just education. It's a career transformation.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:24px;\">\n    <!-- Before -->\n    <div style=\"background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.12);border-radius:24px;padding:36px;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(to bottom, #ef4444, transparent);\"></div>\n      <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:24px;\">\n        <span style=\"font-size:28px;\">😔</span>\n        <h3 style=\"font-size:20px;font-weight:700;color:rgba(248,113,113,0.9);margin:0;\">Before</h3>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:16px;\">\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.5);font-size:15px;\">\n          <span style=\"color:rgba(239,68,68,0.6);font-size:14px;\">✕</span> No Python or coding experience\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.5);font-size:15px;\">\n          <span style=\"color:rgba(239,68,68,0.6);font-size:14px;\">✕</span> AI feels like magic you can't understand\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.5);font-size:15px;\">\n          <span style=\"color:rgba(239,68,68,0.6);font-size:14px;\">✕</span> Empty GitHub portfolio\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.5);font-size:15px;\">\n          <span style=\"color:rgba(239,68,68,0.6);font-size:14px;\">✕</span> Not qualified for AI engineering roles\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.5);font-size:15px;\">\n          <span style=\"color:rgba(239,68,68,0.6);font-size:14px;\">✕</span> Watching tutorials without building anything\n        </div>\n      </div>\n    </div>\n    <!-- After -->\n    <div style=\"background:rgba(16,185,129,0.04);border:1px solid rgba(16,185,129,0.12);border-radius:24px;padding:36px;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(to bottom, #10b981, transparent);\"></div>\n      <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:24px;\">\n        <span style=\"font-size:28px;\">🚀</span>\n        <h3 style=\"font-size:20px;font-weight:700;color:rgba(52,211,153,0.9);margin:0;\">After</h3>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:16px;\">\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.8);font-size:15px;font-weight:500;\">\n          <span style=\"color:rgba(16,185,129,0.8);font-size:14px;\">✓</span> Professional Python & FastAPI developer\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.8);font-size:15px;font-weight:500;\">\n          <span style=\"color:rgba(16,185,129,0.8);font-size:14px;\">✓</span> Build & deploy production AI applications\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.8);font-size:15px;font-weight:500;\">\n          <span style=\"color:rgba(16,185,129,0.8);font-size:14px;\">✓</span> 15+ real projects in your portfolio\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.8);font-size:15px;font-weight:500;\">\n          <span style=\"color:rgba(16,185,129,0.8);font-size:14px;\">✓</span> Qualified for AI engineer positions\n        </div>\n        <div style=\"display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.8);font-size:15px;font-weight:500;\">\n          <span style=\"color:rgba(16,185,129,0.8);font-size:14px;\">✓</span> Confident with LLMs, RAG, Agents & MCP\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "What You'll Build",
            "explanation": "",
            "audio": "You will build six real-world applications including a Student Info System, House Price Predictor, Image Classifier, Sentiment Analyzer, Enterprise RAG System, and a full AI Code Reviewer as your capstone project.",
            "html_code": "<style>\n  .project-card {\n    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;\n  }\n  .project-card:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 12px 30px rgba(0,0,0,0.5);\n    border-color: rgba(255,255,255,0.2) !important;\n  }\n  .project-badge {\n    transition: transform 0.3s ease, filter 0.3s ease;\n  }\n  .project-card:hover .project-badge {\n    transform: scale(1.05);\n    filter: brightness(1.2);\n  }\n</style>\n<div style=\"padding:0;\">\n  <div style=\"text-align:center;margin-bottom:48px;\">\n    <p style=\"font-size:clamp(16px,2vw,20px);color:rgba(255,255,255,0.5);text-align:center;max-width:640px;margin:0 auto 48px auto;line-height:1.6;font-weight:400;margin-top:0;\">Real projects. Real complexity. Ready for your portfolio and interviews.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3, 1fr);gap:16px;\">\n    <div class=\"project-card\" style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">🎯</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">Student Info System</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">Full CRUD application with REST API.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(59,130,246,0.15);color:#3b82f6;\">Beginner</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">Python · FastAPI</span>\n      </div>\n    </div>\n    <div class=\"project-card\" style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">🏠</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">House Price Predictor</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">End-to-end ML pipeline with deployment.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(168,85,247,0.15);color:#a855f7;\">Intermediate</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">Scikit-learn · ML</span>\n      </div>\n    </div>\n    <div class=\"project-card\" style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">🐱</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">Image Classifier</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">Deep learning CNN for visual recognition.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(168,85,247,0.15);color:#a855f7;\">Intermediate</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">TensorFlow · CNN</span>\n      </div>\n    </div>\n    <div class=\"project-card\" style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">💬</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">Sentiment Analyzer</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">NLP pipeline with LSTM networks.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(16,185,129,0.15);color:#10b981;\">Advanced</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">NLP · LSTM</span>\n      </div>\n    </div>\n    <div class=\"project-card\" style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">📚</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">Enterprise RAG System</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">Intelligent Q&A over custom data.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(16,185,129,0.15);color:#10b981;\">Advanced</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">LangChain · Vectors</span>\n      </div>\n    </div>\n    <div class=\"project-card\" style=\"background:linear-gradient(135deg, rgba(139,92,246,0.06), rgba(59,130,246,0.04));border:1px solid rgba(139,92,246,0.2);border-radius:20px;padding:28px;display:flex;flex-direction:column;cursor:pointer;\">\n      <div style=\"font-size:40px;margin-bottom:16px;\">🤖</div>\n      <h3 style=\"font-size:18px;font-weight:700;color:#ffffff;margin:0 0 8px 0;\">AI Code Reviewer</h3>\n      <p style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 20px 0;line-height:1.5;flex:1;\">Multi-agent production system.</p>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid rgba(255,255,255,0.05);\">\n        <span class=\"project-badge\" style=\"display:inline-block;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px;border-radius:100px;background:rgba(139,92,246,0.15);color:#ffffff;\">Capstone</span>\n        <span style=\"font-size:12px;color:rgba(255,255,255,0.3);font-family:'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\">LangGraph · Agents</span>\n      </div>\n    </div>\n  </div>\n</div>"
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Learning Journey",
            "explanation": "",
            "audio": "Your learning journey covers eight phases: Python Foundation, Machine Learning, Deep Learning, NLP and Transformers, LLMs and Prompting, Semantic Search and RAG, AI Agents and Frameworks, and finally Production and Deployment.",
            "html_code": "<div style=\"padding:16px 0;\">\n  <div style=\"text-align:center;margin-bottom:48px;\">\n    <p style=\"font-size:clamp(16px,2vw,20px);color:rgba(255,255,255,0.5);text-align:center;max-width:640px;margin:0 auto 48px auto;line-height:1.6;font-weight:400;margin-top:0;\">A structured path from Python fundamentals to production AI systems.</p>\n  </div>\n  <div style=\"max-width:560px;margin:0 auto;display:flex;flex-direction:column;\">\n  <div style=\"display:flex;gap:32px;align-items:stretch;position:relative;margin-bottom:24px;\" onmouseover=\"this.children[2].style.transform='translateX(8px)';this.children[2].style.borderColor='#3b82f660';this.children[2].style.background='linear-gradient(90deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02))';this.children[1].children[0].style.boxShadow='0 0 30px #3b82f680, inset 0 0 10px #3b82f680'\" onmouseout=\"this.children[2].style.transform='translateX(0)';this.children[2].style.borderColor='rgba(255,255,255,0.08)';this.children[2].style.background='rgba(255,255,255,0.03)';this.children[1].children[0].style.boxShadow='0 0 20px #3b82f640'\">\n    <!-- Timeline Line Behind -->\n    <div style=\"position:absolute;left:23px;top:64px;bottom:-24px;width:2px;background:linear-gradient(to bottom, #3b82f680, #6366f180);opacity:0.6;z-index:0;\"></div>\n    <!-- Timeline dot -->\n    <div style=\"display:flex;flex-direction:column;align-items:center;min-width:48px;position:relative;z-index:1;padding-top:16px;\">\n      <div style=\"width:48px;height:48px;border-radius:50%;background:#05050a;border:2px solid #3b82f6;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;color:#ffffff;box-shadow:0 0 20px #3b82f640;transition:all 0.3s ease;position:relative;overflow:hidden;\">\n        <div style=\"position:absolute;inset:0;background:#3b82f6;opacity:0.2;\"></div>\n        <span style=\"position:relative;z-index:1;\">01</span>\n      </div>\n    </div>\n    <!-- Content Card -->\n    <div style=\"flex:1;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:24px;transition:all 0.3s ease;position:relative;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.2);\">\n      <!-- Subtle top glow -->\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:1px;background:linear-gradient(90deg, transparent, #3b82f660, transparent);\"></div>\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;\">\n        <h3 style=\"font-size:22px;font-weight:800;color:#ffffff;margin:0;letter-spacing:-0.02em;\">Python Foundation</h3>\n        <span style=\"font-size:12px;font-weight:700;color:#3b82f6;background:#3b82f615;padding:4px 12px;border-radius:100px;border:1px solid #3b82f630;letter-spacing:0.05em;white-space:nowrap;\">~2 weeks</span>\n      </div>\n      <p style=\"font-size:15px;color:rgba(255,255,255,0.6);margin:0;line-height:1.6;\">Variables, OOP, Async, FastAPI</p>\n    </div>\n  </div>\n  <div style=\"display:flex;gap:32px;align-items:stretch;position:relative;margin-bottom:24px;\" onmouseover=\"this.children[2].style.transform='translateX(8px)';this.children[2].style.borderColor='#6366f160';this.children[2].style.background='linear-gradient(90deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02))';this.children[1].children[0].style.boxShadow='0 0 30px #6366f180, inset 0 0 10px #6366f180'\" onmouseout=\"this.children[2].style.transform='translateX(0)';this.children[2].style.borderColor='rgba(255,255,255,0.08)';this.children[2].style.background='rgba(255,255,255,0.03)';this.children[1].children[0].style.boxShadow='0 0 20px #6366f140'\">\n    <!-- Timeline Line Behind -->\n    <div style=\"position:absolute;left:23px;top:64px;bottom:-24px;width:2px;background:linear-gradient(to bottom, #6366f180, #a855f780);opacity:0.6;z-index:0;\"></div>\n    <!-- Timeline dot -->\n    <div style=\"display:flex;flex-direction:column;align-items:center;min-width:48px;position:relative;z-index:1;padding-top:16px;\">\n      <div style=\"width:48px;height:48px;border-radius:50%;background:#05050a;border:2px solid #6366f1;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;color:#ffffff;box-shadow:0 0 20px #6366f140;transition:all 0.3s ease;position:relative;overflow:hidden;\">\n        <div style=\"position:absolute;inset:0;background:#6366f1;opacity:0.2;\"></div>\n        <span style=\"position:relative;z-index:1;\">02</span>\n      </div>\n    </div>\n    <!-- Content Card -->\n    <div style=\"flex:1;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:24px;transition:all 0.3s ease;position:relative;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.2);\">\n      <!-- Subtle top glow -->\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:1px;background:linear-gradient(90deg, transparent, #6366f160, transparent);\"></div>\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;\">\n        <h3 style=\"font-size:22px;font-weight:800;color:#ffffff;margin:0;letter-spacing:-0.02em;\">Machine Learning</h3>\n        <span style=\"font-size:12px;font-weight:700;color:#6366f1;background:#6366f115;padding:4px 12px;border-radius:100px;border:1px solid #6366f130;letter-spacing:0.05em;white-space:nowrap;\">~3 weeks</span>\n      </div>\n      <p style=\"font-size:15px;color:rgba(255,255,255,0.6);margin:0;line-height:1.6;\">Regression, classification, evaluation</p>\n    </div>\n  </div>\n  <div style=\"display:flex;gap:32px;align-items:stretch;position:relative;margin-bottom:24px;\" onmouseover=\"this.children[2].style.transform='translateX(8px)';this.children[2].style.borderColor='#a855f760';this.children[2].style.background='linear-gradient(90deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02))';this.children[1].children[0].style.boxShadow='0 0 30px #a855f780, inset 0 0 10px #a855f780'\" onmouseout=\"this.children[2].style.transform='translateX(0)';this.children[2].style.borderColor='rgba(255,255,255,0.08)';this.children[2].style.background='rgba(255,255,255,0.03)';this.children[1].children[0].style.boxShadow='0 0 20px #a855f740'\">\n    <!-- Timeline Line Behind -->\n    <div style=\"position:absolute;left:23px;top:64px;bottom:-24px;width:2px;background:linear-gradient(to bottom, #a855f780, #ec489980);opacity:0.6;z-index:0;\"></div>\n    <!-- Timeline dot -->\n    <div style=\"display:flex;flex-direction:column;align-items:center;min-width:48px;position:relative;z-index:1;padding-top:16px;\">\n      <div style=\"width:48px;height:48px;border-radius:50%;background:#05050a;border:2px solid #a855f7;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;color:#ffffff;box-shadow:0 0 20px #a855f740;transition:all 0.3s ease;position:relative;overflow:hidden;\">\n        <div style=\"position:absolute;inset:0;background:#a855f7;opacity:0.2;\"></div>\n        <span style=\"position:relative;z-index:1;\">03</span>\n      </div>\n    </div>\n    <!-- Content Card -->\n    <div style=\"flex:1;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:24px;transition:all 0.3s ease;position:relative;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,0.2);\">\n      <!-- Subtle top glow -->\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:1px;background:linear-gradient(90deg, transparent, #a855f760, transparent);\"></div>\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;\">\n        <h3 style=\"font-size:22px;font-weight:800;color:#ffffff;margin:0;letter-spacing:-0.02em;\">Deep Learning & Vision</h3>\n        <span style=\"font-size:12px;font-weight:700;color:#a855f7;background:#a855f715;padding:4px 12px;border-radius:100px;border:1px solid #a855f730;letter-spacing:0.05em;white-space:nowrap;\">~2 weeks</span>\n      </div>