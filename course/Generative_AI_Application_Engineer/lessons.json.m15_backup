        {
          "type": "code",
          "challenge": {
            "question": "Project: Multi-Model Playground. Write a Python script that takes a user prompt, calls a mock API or calculates the estimated cost and execution speeds for both GPT-4o-mini ($0.15/1M input) and Claude 3.5 Sonnet ($3.00/1M input). Output a comparative table.",
            "starterCode": "def compare_model_runs(prompt, input_tokens, output_tokens):\n    # GPT-4o-mini: Input is $0.15/1M, Output is $0.60/1M\n    gpt_mini_cost = (input_tokens * 0.15 / 1e6) + (output_tokens * 0.60 / 1e6)\n    # Claude 3.5 Sonnet: Input is $3.00/1M, Output is $15.00/1M\n    # TODO: Calculate Claude 3.5 Sonnet cost\n    claude_cost = (input_tokens * ____) + (output_tokens * ____)\n    \n    print(f\"GPT-4o-mini Cost: ${gpt_mini_cost:.6f}\")\n    print(f\"Claude 3.5 Cost: ${claude_cost:.6f}\")\n    return gpt_mini_cost, claude_cost\n\n# Test execution\ncompare_model_runs(\"Write a sorting algorithm in Python.\", 2000, 800)",
            "solution": "def compare_model_runs(prompt, input_tokens, output_tokens):\n    # GPT-4o-mini: Input is $0.15/1M, Output is $0.60/1M\n    gpt_mini_cost = (input_tokens * 0.15 / 1e6) + (output_tokens * 0.60 / 1e6)\n    # Claude 3.5 Sonnet: Input is $3.00/1M, Output is $15.00/1M\n    # TODO: Calculate Claude 3.5 Sonnet cost\n    claude_cost = (input_tokens * 3.00 / 1e6) + (output_tokens * 15.00 / 1e6)\n    \n    print(f\"GPT-4o-mini Cost: ${gpt_mini_cost:.6f}\")\n    print(f\"Claude 3.5 Cost: ${claude_cost:.6f}\")\n    return gpt_mini_cost, claude_cost\n\n# Test execution\ncompare_model_runs(\"Write a sorting algorithm in Python.\", 2000, 800)",
            "language": "python",
            "hint": "Multiply input_tokens by 3.00 / 1e6 and output_tokens by 15.00 / 1e6.",
            "explanation": "Analyzing cost structures across providers helps optimize developer API spend based on tasks."
