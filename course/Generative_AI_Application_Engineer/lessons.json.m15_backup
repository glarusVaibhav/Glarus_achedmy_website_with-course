        {
          "type": "scenario",
          "content": {
            "title": "Trust Boundary Decision",
            "description": "Your MCP server has two tools: 'search_knowledge_base' (read-only) and 'update_customer_record' (writes to CRM). A junior developer on the team suggests putting both in the same server. What do you do?",
