        {
          "type": "code",
          "challenge": {
            "title": "Build The Enterprise Semantic Router",
            "difficulty": "Hard",
            "question": "Build an AI support router. Given an angry customer email, encode it using an open-source model and use Cosine Similarity to automatically route it to the correct department.",
            "starterCode": "from sentence_transformers import SentenceTransformer, util\n\n# 1. Initialize local open-source model\nmodel = SentenceTransformer('all-MiniLM-L6-v2')\n\n# 2. Our knowledge base\ndepartments = [\n  \"Billing, invoices, failed payments, and refunds\",\n  \"Shipping delays, lost tracking numbers, and warehouse logistics\"\n]\ndepartment_vectors = model.encode(departments)\n\n# 3. New incoming ticket\nticket = \"I was charged twice on my credit card for the same item!\"\n\n# TODO: Encode the ticket and calculate similarity scores\n# scores = \n\n# print(f\"Routing Scores: {scores}\")",
            "language": "python",
            "expected_output": "tensor([[0.65, 0.12]])",
            "hint": "Use util.cos_sim(ticket_vector, department_vectors)",
            "solution": "from sentence_transformers import SentenceTransformer, util\n\nmodel = SentenceTransformer('all-MiniLM-L6-v2')\n\ndepartments = [\n  \"Billing, invoices, failed payments, and refunds\",\n  \"Shipping delays, lost tracking numbers, and warehouse logistics\"\n]\ndepartment_vectors = model.encode(departments)\n\nticket = \"I was charged twice on my credit card for the same item!\"\nticket_vector = model.encode(ticket)\n\nscores = util.cos_sim(ticket_vector, department_vectors)\n\n# Index 0 (Billing) is the clear winner!\nprint(f\"Routing Scores: {scores}\")"
          }
