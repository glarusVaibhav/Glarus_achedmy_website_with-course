        {
          "type": "flashcard",
          "cards": [
            {
              "front": "What is the primary purpose of a Vector Database?",
              "back": "A Vector Database stores and retrieves embeddings based on semantic similarity and mathematical proximity rather than exact keyword matches."
            },
            {
              "front": "What problem does Metadata Filtering solve in Vector Databases?",
              "back": "Metadata Filtering adds exact logical constraints (e.g., years of experience, role, location) before semantic search, enabling Hybrid Search with both meaning and strict rules."
            }
