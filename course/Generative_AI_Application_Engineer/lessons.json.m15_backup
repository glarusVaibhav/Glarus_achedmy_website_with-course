          ],
          "explanation": "C-I-I-O stands for Context, Instruction, Input, and Output."
        },
        {
          "type": "ai_conversation",
          "title": "Improve the Prompt",
          "systemPrompt": "A user asks an AI: 'Write a blog post about fitness.'",
