      "id": "M005-llm-project",
      "title": "Beginner LLM Projects",
      "stages": [
        {
          "type": "concept",
          "content": {
            "title": "Project 1: AI Text Generator",
            "explanation": "In this project, you will build a simple AI Text Generator using the OpenAI API. The user enters a prompt and the model generates text.\n\n**Skills Learned:**\n• Calling an LLM API\n• Sending prompts\n• Handling responses\n• Working with generation parameters\n\n**Required Libraries:**\n`pip install openai`\n\n**Project Workflow:**\nUser Prompt → OpenAI API → GPT Model → Generated Text",
            "example": "Prompt: 'Write a motivational quote about learning.'\n\nOutput:\n'Every expert was once a beginner who refused to give up.'",
            "tip": "Start with a console application before building a web UI."
          }
        },
        {
          "type": "code",
          "challenge": {
            "question": "Build an AI Text Generator using OpenAI API.",
            "starterCode": "from openai import OpenAI\n\nclient = OpenAI(api_key='YOUR_API_KEY')\n\nprompt = input('Enter Prompt: ')\n",
            "solution": "from openai import OpenAI\n\nclient = OpenAI(api_key='YOUR_API_KEY')\n\nprompt = input('Enter Prompt: ')\n\nresponse = client.chat.completions.create(\n model='gpt-4o-mini',\n messages=[{'role':'user','content':prompt}]\n)\n\nprint(response.choices[0].message.content)",
            "language": "python",
            "hint": "Use client.chat.completions.create().",
            "explanation": "The application sends the prompt to GPT and displays the generated text."
          }
        },
        {
          "type": "concept",
          "content": {
            "title": "Project 2: AI Summarizer",
            "explanation": "Build an application that converts long text into short summaries.\n\n**Skills Learned:**\n• Prompt Engineering\n• Text Processing\n• LLM Summarization\n\n**Workflow:**\nLong Text → Prompt → GPT → Summary",
            "example": "Input: 500-word article\nOutput: 50-word summary",
            "tip": "Always specify the summary length in the prompt."
          }
        },
