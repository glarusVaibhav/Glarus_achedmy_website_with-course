        {
          "type": "visual",
          "content": {
            "title": "Client-Server Communication Flow",
            "description": "Every AI application follows this exact pattern. The client sends a request, the server processes it with your AI model, and sends back the response. Understanding this flow is the foundation of backend development.",
            "type": "lcel_pipeline",
            "steps": [
              {
                "name": "Client (Browser / App)",
