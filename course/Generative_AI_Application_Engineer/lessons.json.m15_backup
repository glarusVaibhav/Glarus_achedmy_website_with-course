            "starterCode": "from langchain_mcp_adapters.client import MultiServerMCPClient\nfrom langgraph.prebuilt import create_react_agent\nfrom langchain_openai import ChatOpenAI\n\n# Configure the MCP client with server details\nclient = MultiServerMCPClient({\n    'math': ___\n})\n\n# Get tools from MCP servers\ntools = ___\n\n# Create the ReAct agent\nagent = ___",
            "solution": "from langchain_mcp_adapters.client import MultiServerMCPClient\nfrom langgraph.prebuilt import create_react_agent\nfrom langchain_openai import ChatOpenAI\n\nclient = MultiServerMCPClient({\n    'math': {\n        'command': 'python',\n        'args': ['math_server.py'],\n        'transport': 'stdio'\n    }\n})\n\ntools = client.get_tools()\n\nagent = create_react_agent(ChatOpenAI(model='gpt-4o-mini'), tools)",
