              {
                "id": "logger",
                "label": "Response Logger",
                "description": "Logs request/response metadata for analytics, debugging, and compliance"
              },
              {
                "id": "response",
                "label": "Client Response",
                "description": "Processed response streamed back to the user's browser"
              }
            ],
            "edges": [
              {
                "from": "client",
                "to": "ssl",
                "label": "HTTPS"
              },
              {
                "from": "ssl",
                "to": "auth",
                "label": "HTTP"
              },
              {
                "from": "auth",
                "to": "rate-limit",
                "label": "Valid Token"
              },
              {
                "from": "rate-limit",
                "to": "router",
                "label": "Under Limit"
              },
              {
                "from": "router",
