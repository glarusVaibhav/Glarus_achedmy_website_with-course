            "question": "Write a function called 'deduplicate_dataset' that takes a list of training examples (dicts with 'instruction' and 'output' keys). Remove exact duplicate instructions (case-insensitive), remove examples where the output is shorter than 30 characters, and return the filtered list.",
            "starterCode": "def deduplicate_dataset(examples: list) -> list:\n    '''Remove duplicates and low-quality examples.'''\n    seen = set()\n    filtered = []\n    for ex in examples:\n        instruction_key = ex['instruction'].strip().lower()\n        # Skip duplicates and short outputs\n        ___\n    return filtered",
            "solution": "def deduplicate_dataset(examples: list) -> list:\n    '''Remove duplicates and low-quality examples.'''\n    seen = set()\n    filtered = []\n    for ex in examples:\n        instruction_key = ex['instruction'].strip().lower()\n        if instruction_key in seen:\n            continue\n        if len(ex['output'].strip()) < 30:\n            continue\n        seen.add(instruction_key)\n        filtered.append(ex)\n    return filtered",
            "hint": "Check 'if instruction_key in seen' to skip duplicates, check output length, add to seen set and filtered list.",
            "explanation": "Deduplication prevents the model from memorizing repeated examples. The 30-character minimum ensures all training responses have enough substance. This simple filter can remove 10-30% of synthetic data issues.",
