              },
              {
                "name": "Step 2: Instant Response",
                "output": "{\n  \"job_id\": \"job_abc123\",\n  \"status\": \"accepted\",\n  \"message\": \"Report generation started!\"\n}",
                "description": "Server responds IMMEDIATELY with a job ID. The user is NOT waiting!",
                "outputType": "JOB ID"
              },
              {
                "name": "Step 3: Background Processing",
                "processing": "Worker researches → generates → compiles report (5-8 min)...",
                "output": "Progress: 30% → 60% → 90% → 100% ✓",
                "description": "The heavy work runs in the background. The user can do other things.",
                "outputType": "PROCESSING"
              },
              {
                "name": "Step 4: Poll for Status",
                "input": "GET /reports/job_abc123",
                "output": "{\n  \"status\": \"completed\",\n  \"progress\": 100,\n  \"result\": \"Your 10-page report...\"\n}",
                "description": "User checks back anytime to see the progress or retrieve the result.",
                "outputType": "COMPLETE"
              }
            ],
            "codePanel": {
              "title": "Background Code",
              "code": "from fastapi import (\n    FastAPI, BackgroundTasks\n)\n\n@app.post('/reports')\nasync def create_report(\n    topic: str,\n    bg: BackgroundTasks\n):\n    job_id = generate_id()\n    bg.add_task(\n        generate_report,\n        job_id, topic\n    )\n    return {\n        'job_id': job_id,\n        'status': 'accepted'\n    }"
            },
            "typeFlowPanel": {
              "title": "Key Pattern",
              "flow": [
                "POST → Start task",
                "Return job_id instantly",
                "Process in background",
                "GET → Poll for status",
