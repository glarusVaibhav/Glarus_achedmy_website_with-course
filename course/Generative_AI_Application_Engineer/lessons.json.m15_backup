                      "For truly new queries only"
                    ]
                  }
                ]
              }
            ],
            "sidePanel": {
              "title": "Cache Lookup Flow",
              "flow": [
                "User sends query",
                "Check Redis (exact match)",
                "Check Semantic Cache (similar)",
                "Check Provider Prefix Cache",
                "Cache Miss: Call LLM",
                "Store result in cache",
                "Return response"
              ]
            }
          }
        },
        {
          "type": "code",
          "challenge": {
            "language": "python",
            "title": "Semantic Cache Implementation",
            "difficulty": "Medium",
            "question": "Complete the semantic cache. The 'get' method should compute cosine similarity between the query embedding and each cached embedding, returning the cached response if similarity exceeds the threshold.",
            "starterCode": "from openai import OpenAI\nimport numpy as np\n\nclient = OpenAI()\n\nclass SemanticCache:\n    def __init__(self, threshold=0.95):\n        self.cache = []\n        self.threshold = threshold\n    \n    def get_embedding(self, text):\n        r = client.embeddings.create(model=\"text-embedding-3-small\", input=text)\n        return np.array(r.data[0].embedding)\n    \n    def cosine_sim(self, a, b):\n        return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))\n    \n    def get(self, query):\n        query_emb = self.get_embedding(query)\n        # TODO: Check each cached embedding for similarity\n        pass\n    \n    def set(self, query, response):\n        emb = self.get_embedding(query)\n        self.cache.append((emb, response))",
            "solution": "from openai import OpenAI\nimport numpy as np\n\nclient = OpenAI()\n\nclass SemanticCache:\n    def __init__(self, threshold=0.95):\n        self.cache = []\n        self.threshold = threshold\n    \n    def get_embedding(self, text):\n        r = client.embeddings.create(model=\"text-embedding-3-small\", input=text)\n        return np.array(r.data[0].embedding)\n    \n    def cosine_sim(self, a, b):\n        return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))\n    \n    def get(self, query):\n        query_emb = self.get_embedding(query)\n        for cached_emb, cached_response in self.cache:\n            if self.cosine_sim(query_emb, cached_emb) > self.threshold:\n                return cached_response\n        return None\n    \n    def set(self, query, response):\n        emb = self.get_embedding(query)\n        self.cache.append((emb, response))",
            "hint": "Loop through self.cache, compute cosine_sim between query_emb and each cached_emb.",
            "explanation": "The semantic cache converts queries to embedding vectors and finds similar cached queries using cosine similarity.",
            "concepts": [
              "Semantic Cache",
              "Embeddings",
              "Cosine Similarity"
            ],
            "validation": {
              "type": "regex_match",
              "pattern": "cosine_sim.*query_emb.*cached_emb"
            }
          }
        },
