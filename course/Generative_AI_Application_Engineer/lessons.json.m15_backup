            "solution": "from pydantic import BaseModel\nfrom openai import OpenAI\n\nclient = OpenAI()\nclass User(BaseModel):\n    name: str\n    age: int\n\nresponse = client.beta.chat.completions.parse(\n    model=\"gpt-4o\",\n    messages=[{\"role\": \"user\", \"content\": \"Extract: John is 30\"}],\n    response_format=User\n)",
            "hint": "Use client.beta.chat.completions.parse and response_format=User",
            "explanation": "The parse method handles extracting the structured object perfectly matching your Pydantic schema.",
            "validation": {
              "type": "regex_match",
              "pattern": "response_format=User"
            }
          }
        },
