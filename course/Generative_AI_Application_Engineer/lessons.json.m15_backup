            },
            {
              "text": "A hospital wants to flag an MRI scan as 'Tumor' or 'Healthy'.",
              "outcome": "Incorrect. This is predicting a category, making it a Classification problem.",
              "score": 0
            },
            {
              "text": "A logistics company wants to estimate the exact delivery time in hours based on traffic, weather, and distance.",
              "outcome": "Correct. Time is continuous, and using multiple features makes this a Multiple Linear Regression problem.",
              "score": 100
