                      "~$0.00002 per lookup"
                    ]
                  }
                ]
              },
              {
                "id": "cache-l3",
                "name": "Level 3: Provider Prefix Cache",
                "badge": "Automatic",
                "packages": [
                  {
                    "id": "prefix-cache",
                    "label": "OpenAI / Anthropic",
                    "items": [
                      "Caches system prompt tokens",
