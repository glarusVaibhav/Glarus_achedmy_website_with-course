          "type": "mcq",
          "questions": [
            {
              "question": "A model scores 55% on training data and 53% on test data. Which stage best describes this model?",
              "options": [
                "Overfitting",
                "Underfitting",
                "Good Generalization",
                "Data Leakage"
              ],
              "answer": 1,
              "explanation": "The model performs poorly on both training and test data, indicating underfitting."
            },
            {
              "question": "Which of the following is a sign of High Bias?",
              "options": [
                "Excellent training performance",
                "Poor training and poor test performance",
                "Large gap between training and test scores",
                "Model memorizing training data"
              ],
              "answer": 1,
              "explanation": "High bias models are too simple and cannot learn the underlying patterns."
            },
            {
              "question": "Which of the following is a sign of High Variance?",
              "options": [
                "Poor training accuracy",
                "Similar training and test scores",
                "Large difference between training and test performance",
                "Simple model assumptions"
              ],
              "answer": 2,
              "explanation": "High variance causes overfitting, creating a large train-test gap."
            },
            {
              "question": "A Decision Tree with unlimited depth is most likely in which stage?",
              "options": [
                "Underfitting",
                "Overfitting",
                "Balanced Bias-Variance",
                "Feature Engineering"
              ],
              "answer": 1,
              "explanation": "Very deep trees often memorize training data."
            },
            {
              "question": "A Linear Regression model used on highly complex nonlinear data is likely experiencing:",
              "options": [
                "Overfitting",
                "Good Generalization",
                "Underfitting",
                "High Variance"
              ],
              "answer": 2,
              "explanation": "The model is too simple to capture complex patterns."
            },
            {
              "question": "The ideal point in the Bias-Variance Tradeoff is:",
              "options": [
                "High Bias, Low Variance",
                "Low Bias, High Variance",
                "Balanced Bias and Variance",
                "Zero Bias, Zero Variance"
              ],
              "answer": 2,
              "explanation": "The goal is to achieve the best generalization by balancing bias and variance."
            }
          ]
        }
      ]
