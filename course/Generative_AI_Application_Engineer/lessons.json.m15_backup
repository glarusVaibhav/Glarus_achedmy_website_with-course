            }
          }
        },
        {
          "type": "code",
          "challenge": {
            "title": "Build It: Calculate Vector Distance",
            "difficulty": "Medium",
            "question": "Using Python's NumPy library, write the mathematical operation to calculate the raw Dot Product of a query vector and a document vector.",
            "starterCode": "import numpy as np\n\nquery_vector = np.array([0.5, 0.2, -0.1])\ndoc_vector = np.array([0.4, 0.8, 0.0])\n\n# TODO: Calculate the Dot Product using numpy\ndot_product_score = \n\nprint(f\"Similarity Score: {dot_product_score}\")",
            "language": "python",
            "expected_output": "Similarity Score: 0.36",
            "hint": "Use the np.dot() function.",
            "solution": "import numpy as np\n\nquery_vector = np.array([0.5, 0.2, -0.1])\ndoc_vector = np.array([0.4, 0.8, 0.0])\n\n# Calculate the Dot Product\ndot_product_score = np.dot(query_vector, doc_vector)\n\nprint(f\"Similarity Score: {dot_product_score}\")"
          }
        },
        {
